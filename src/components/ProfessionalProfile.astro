---
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sectionId = locale === 'en' ? 'trajectory' : 'recorrido';

const knowitBullets = [
  t('profile.knowit.b1'),
  t('profile.knowit.b2'),
  t('profile.knowit.b3'),
  t('profile.knowit.b4'),
];

const knowitTags =
  locale === 'en'
    ? ['Microsoft Azure', 'AWS', 'Linux', 'Windows Server', 'PowerShell', 'Networking']
    : ['Microsoft Azure', 'AWS', 'Linux', 'Windows Server', 'PowerShell', 'Redes'];

const credentials = [
  { title: t('profile.certs.c1.title'), meta: t('profile.certs.c1.meta'), highlight: true },
  { title: t('profile.certs.c2.title'), meta: t('profile.certs.c2.meta'), highlight: true },
  { title: t('profile.certs.c3.title'), meta: t('profile.certs.c3.meta'), highlight: false },
  { title: t('profile.certs.c4.title'), meta: t('profile.certs.c4.meta'), highlight: false },
];

const expandLabel = locale === 'en' ? 'Details' : 'Ver detalles';
const collapseLabel = locale === 'en' ? 'Hide' : 'Ocultar';
const knowitPreview = 'Azure · AWS · Linux · PowerShell +2';
const eduPreview = 'ICPC Finals · IEEEXtreme · +2';
---

<section
  id={sectionId}
  data-scroll-module
  class="relative w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-9 sm:py-24 border-t border-border-subtle"
  aria-labelledby="profile-heading"
>
  <!-- Clean Single-Level Section Header -->
  <div class="max-w-3xl mb-6 sm:mb-14 space-y-2.5 sm:space-y-3" data-section-header>
    <p class="text-xs font-mono-tech uppercase tracking-widest text-accent-primary font-semibold">
      {t('profile.sectionIndex')}
    </p>
    <h2
      id="profile-heading"
      class="text-2xl sm:text-4xl font-normal tracking-[-0.03em] leading-tight text-fg-primary"
    >
      {t('profile.title')}
    </h2>
    <p class="text-sm sm:text-base text-fg-secondary leading-relaxed text-pretty">
      {t('profile.subtitle')}
    </p>
  </div>

  <!-- Structured Career & Education Cards -->
  <div class="space-y-3.5 sm:space-y-6">
    <!-- 1. KnowIT Role Card -->
    <article class="group relative border border-border-subtle bg-canvas p-4 sm:p-8 shadow-xs transition-card hover:border-accent-primary/35 hover:shadow-md max-sm:data-[open=true]:border-accent-primary/40 max-sm:data-[open=true]:shadow-sm max-sm:has-[[data-expand-trigger]:focus-visible]:outline-2 max-sm:has-[[data-expand-trigger]:focus-visible]:outline-offset-2 max-sm:has-[[data-expand-trigger]:focus-visible]:outline-accent-primary overflow-hidden">
      <div
        class="sm:hidden absolute inset-x-0 top-0 z-10 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-accent-primary via-accent-interactive to-transparent transition-transform duration-300 group-data-[open=true]:scale-x-100"
        aria-hidden="true"
      ></div>

      <!-- Desktop / Tablet View (>= 640px) — 100% Static Editorial Card -->
      <div class="hidden sm:block">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-3 pb-3.5 sm:pb-5 border-b border-border-subtle/70">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
              <h3 class="text-lg sm:text-2xl font-medium tracking-tight text-fg-primary">
                {t('profile.knowit.role')}
              </h3>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-mono-tech border border-accent-primary/20 bg-accent-subtle text-accent-primary font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-status-active" aria-hidden="true"></span>
                {t('profile.knowit.badge')}
              </span>
            </div>
            <p class="text-sm font-medium text-accent-primary">
              {t('profile.knowit.org')}
            </p>
          </div>

          <div class="text-xs font-mono-tech text-fg-muted sm:text-right shrink-0 space-y-0.5">
            <p class="text-fg-primary font-medium">{t('profile.knowit.period')}</p>
            <p>{t('profile.knowit.location')}</p>
          </div>
        </div>

        <!-- Impact Bullets (›) -->
        <ul class="mt-3.5 sm:mt-5 space-y-2 sm:space-y-2.5 list-none p-0 m-0">
          {knowitBullets.map((bullet) => (
            <li class="flex items-baseline gap-2.5 sm:gap-3 text-[13.5px] sm:text-[15px] text-fg-secondary leading-relaxed">
              <span class="text-accent-primary font-mono-tech font-bold shrink-0 select-none" aria-hidden="true">›</span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>

        <!-- Role Tech Tags -->
        <div class="mt-4 sm:mt-6 pt-3.5 sm:pt-4 border-t border-border-subtle/60 flex flex-wrap gap-1.5 sm:gap-2">
          {knowitTags.map((tag) => (
            <span class="px-2.5 py-1 text-[11px] font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-primary">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Mobile View (< 640px) — Editorial Expandable Card -->
      <div class="sm:hidden">
        <div class="relative">
          <div class="flex items-start justify-between gap-2.5 mb-2">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0 pt-0.5">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10.5px] font-mono-tech border border-accent-primary/20 bg-accent-subtle text-accent-primary font-medium shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-status-active" aria-hidden="true"></span>
                {t('profile.knowit.badge')}
              </span>
              <span class="text-[11px] font-mono-tech text-fg-muted">
                {t('profile.knowit.period')}
              </span>
            </div>

            <span
              class="inline-flex h-7 w-7 shrink-0 items-center justify-center border border-border-subtle bg-canvas-subtle text-fg-secondary transition-colors duration-200 group-data-[open=true]:border-accent-primary/35 group-data-[open=true]:bg-accent-subtle group-data-[open=true]:text-accent-primary"
              aria-hidden="true"
            >
              <svg
                class="h-3.5 w-3.5 transition-transform duration-300 group-data-[open=true]:rotate-45"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
              >
                <path d="M7 2.5v9M2.5 7h9" />
              </svg>
            </span>
          </div>

          <h3 class="text-[18px] font-medium tracking-tight leading-snug text-fg-primary">
            <button
              type="button"
              aria-expanded="false"
              aria-controls="exp-knowit-panel"
              data-expand-trigger
              class="text-left text-fg-primary transition-colors group-data-[open=true]:text-accent-primary cursor-pointer focus-visible:outline-none after:absolute after:inset-0 after:z-10 after:content-['']"
            >
              {t('profile.knowit.role')}
            </button>
          </h3>

          <p class="mt-1 text-[13px] font-medium text-accent-primary leading-snug">
            {t('profile.knowit.org')}
          </p>

          <div class="mt-3 pt-2.5 border-t border-border-subtle/70 flex items-center justify-between gap-3 text-[11px] font-mono-tech">
            <div class="min-w-0 truncate">
              <span class="text-fg-muted group-data-[open=true]:hidden">{knowitPreview}</span>
              <span class="hidden text-fg-secondary group-data-[open=true]:inline">{t('profile.knowit.location')}</span>
            </div>
            <div class="shrink-0 font-medium text-accent-primary">
              <span class="inline-flex items-center gap-1 group-data-[open=true]:hidden">
                <span>{expandLabel}</span>
                <span aria-hidden="true">↓</span>
              </span>
              <span class="hidden items-center gap-1 group-data-[open=true]:inline-flex">
                <span>{collapseLabel}</span>
                <span aria-hidden="true">↑</span>
              </span>
            </div>
          </div>
        </div>

        <div id="exp-knowit-panel" class="expandable-panel" data-open="false" inert>
          <div class="expandable-panel-inner">
            <div class="pt-3.5">
              <ul class="space-y-2 list-none p-0 m-0">
                {knowitBullets.map((bullet) => (
                  <li class="flex items-baseline gap-2.5 text-[13.5px] text-fg-secondary leading-relaxed">
                    <span class="text-accent-primary font-mono-tech font-bold shrink-0 select-none" aria-hidden="true">›</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-3.5 pt-3 border-t border-border-subtle/60 flex flex-wrap gap-1.5">
                {knowitTags.map((tag) => (
                  <span class="px-2.5 py-1 text-[11px] font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-primary">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>

    <!-- 2. Education & Competitive Programming / Certifications Card -->
    <article class="group relative border border-border-subtle bg-canvas p-4 sm:p-8 shadow-xs transition-card hover:border-accent-primary/35 hover:shadow-md max-sm:data-[open=true]:border-accent-primary/40 max-sm:data-[open=true]:shadow-sm max-sm:has-[[data-expand-trigger]:focus-visible]:outline-2 max-sm:has-[[data-expand-trigger]:focus-visible]:outline-offset-2 max-sm:has-[[data-expand-trigger]:focus-visible]:outline-accent-primary overflow-hidden">
      <div
        class="sm:hidden absolute inset-x-0 top-0 z-10 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-accent-primary via-accent-interactive to-transparent transition-transform duration-300 group-data-[open=true]:scale-x-100"
        aria-hidden="true"
      ></div>

      <!-- Desktop / Tablet View (>= 640px) — 100% Static Editorial Card -->
      <div class="hidden sm:block">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-3 pb-3.5 sm:pb-5 border-b border-border-subtle/70">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
              <h3 class="text-lg sm:text-2xl font-medium tracking-tight text-fg-primary">
                {t('profile.edu.degree')}
              </h3>
              <span class="px-2.5 py-0.5 text-[11px] font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-secondary">
                {t('profile.edu.badge')}
              </span>
            </div>
            <p class="text-sm font-medium text-fg-secondary">
              {t('profile.edu.org')}
            </p>
          </div>

          <div class="text-xs font-mono-tech text-fg-muted sm:text-right shrink-0 space-y-0.5">
            <p class="text-fg-primary font-medium">{t('profile.edu.period')}</p>
            <p>{t('profile.note')}</p>
          </div>
        </div>

        <p class="mt-3.5 sm:mt-4 text-[13.5px] sm:text-[15px] text-fg-secondary leading-relaxed">
          {t('profile.edu.summary')}
        </p>

        <!-- Competitions & Certifications Sub-Grid -->
        <div class="mt-4 sm:mt-6 pt-3.5 sm:pt-5 border-t border-border-subtle/70">
          <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted font-semibold mb-2.5 sm:mb-3">
            {t('profile.certs.label')}
          </p>
          <div class="grid grid-cols-1 min-[480px]:grid-cols-2 sm:grid-cols-2 gap-2 sm:gap-3">
            {credentials.map((cred) => (
              <div class="flex items-start gap-2.5 p-2.5 sm:p-3 border border-border-subtle bg-canvas-subtle/70">
                <span
                  class={`mt-1.5 w-1.5 h-1.5 rounded-full shrink-0 ${cred.highlight ? 'bg-accent-primary' : 'bg-fg-muted'}`}
                  aria-hidden="true"
                ></span>
                <div class="min-w-0">
                  <p class="text-xs sm:text-sm font-medium text-fg-primary leading-snug">
                    {cred.title}
                  </p>
                  <p class="text-[11px] font-mono-tech text-fg-muted mt-0.5">
                    {cred.meta}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Mobile View (< 640px) — Editorial Expandable Card -->
      <div class="sm:hidden">
        <div class="relative">
          <div class="flex items-start justify-between gap-2.5 mb-2">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0 pt-0.5">
              <span class="px-2 py-0.5 text-[10.5px] font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-secondary shrink-0">
                {t('profile.edu.badge')}
              </span>
              <span class="text-[11px] font-mono-tech text-fg-muted">
                {t('profile.edu.period')}
              </span>
            </div>

            <span
              class="inline-flex h-7 w-7 shrink-0 items-center justify-center border border-border-subtle bg-canvas-subtle text-fg-secondary transition-colors duration-200 group-data-[open=true]:border-accent-primary/35 group-data-[open=true]:bg-accent-subtle group-data-[open=true]:text-accent-primary"
              aria-hidden="true"
            >
              <svg
                class="h-3.5 w-3.5 transition-transform duration-300 group-data-[open=true]:rotate-45"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
              >
                <path d="M7 2.5v9M2.5 7h9" />
              </svg>
            </span>
          </div>

          <h3 class="text-[18px] font-medium tracking-tight leading-snug text-fg-primary">
            <button
              type="button"
              aria-expanded="false"
              aria-controls="exp-edu-panel"
              data-expand-trigger
              class="text-left text-fg-primary transition-colors group-data-[open=true]:text-accent-primary cursor-pointer focus-visible:outline-none after:absolute after:inset-0 after:z-10 after:content-['']"
            >
              {t('profile.edu.degree')}
            </button>
          </h3>

          <p class="mt-1 text-[13px] font-medium text-fg-secondary leading-snug">
            {t('profile.edu.org')}
          </p>

          <div class="mt-3 pt-2.5 border-t border-border-subtle/70 flex items-center justify-between gap-3 text-[11px] font-mono-tech">
            <div class="min-w-0 truncate">
              <span class="text-fg-muted group-data-[open=true]:hidden">{eduPreview}</span>
              <span class="hidden text-fg-secondary group-data-[open=true]:inline">{t('profile.note')}</span>
            </div>
            <div class="shrink-0 font-medium text-accent-primary">
              <span class="inline-flex items-center gap-1 group-data-[open=true]:hidden">
                <span>{expandLabel}</span>
                <span aria-hidden="true">↓</span>
              </span>
              <span class="hidden items-center gap-1 group-data-[open=true]:inline-flex">
                <span>{collapseLabel}</span>
                <span aria-hidden="true">↑</span>
              </span>
            </div>
          </div>
        </div>

        <div id="exp-edu-panel" class="expandable-panel" data-open="false" inert>
          <div class="expandable-panel-inner">
            <div class="pt-3.5">
              <p class="text-[13.5px] text-fg-secondary leading-relaxed">
                {t('profile.edu.summary')}
              </p>

              <div class="mt-3.5 pt-3 border-t border-border-subtle/70">
                <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted font-semibold mb-2.5">
                  {t('profile.certs.label')}
                </p>
                <div class="grid grid-cols-1 min-[480px]:grid-cols-2 gap-2">
                  {credentials.map((cred) => (
                    <div class="flex items-start gap-2.5 p-2.5 border border-border-subtle bg-canvas-subtle/70">
                      <span
                        class={`mt-1.5 w-1.5 h-1.5 rounded-full shrink-0 ${cred.highlight ? 'bg-accent-primary' : 'bg-fg-muted'}`}
                        aria-hidden="true"
                      ></span>
                      <div class="min-w-0">
                        <p class="text-xs font-medium text-fg-primary leading-snug">
                          {cred.title}
                        </p>
                        <p class="text-[11px] font-mono-tech text-fg-muted mt-0.5">
                          {cred.meta}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
