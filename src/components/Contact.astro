---
import { siteConfig } from '../config/site';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sectionId = locale === 'en' ? 'contact' : 'contacto';
const consultingHref = locale === 'en' ? '/en/consulting/' : '/consultoria/';
---

<section
  id={sectionId}
  data-scroll-module
  class="relative w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24 border-t border-border-subtle"
  aria-labelledby="contact-heading"
>
  <!-- Clean Single-Level Section Header -->
  <div class="max-w-3xl mb-10 sm:mb-12 space-y-3" data-section-header>
    <p class="text-xs font-mono-tech uppercase tracking-widest text-accent-primary font-semibold">
      {t('contact.sectionIndex')}
    </p>
    <h2
      id="contact-heading"
      class="text-3xl sm:text-4xl font-normal tracking-[-0.03em] leading-tight text-fg-primary"
    >
      {t('contact.title')}
    </h2>
    <p class="text-base text-fg-secondary leading-relaxed text-pretty max-w-2xl">
      {t('contact.subtitle')}
    </p>
  </div>

  <!-- 3 Direct Contact Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" data-contact-grid>
    <a
      href={`mailto:${siteConfig.links.email}`}
      class="group flex items-center justify-between gap-4 border border-border-subtle bg-canvas p-5 shadow-xs transition-card hover:-translate-y-0.5 hover:border-accent-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
    >
      <div class="min-w-0 space-y-1">
        <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted">
          {t('contact.emailLabel')}
        </p>
        <p class="text-sm font-medium text-fg-primary group-hover:text-accent-primary transition-colors truncate">
          {siteConfig.links.email}
        </p>
      </div>
      <span class="text-fg-muted group-hover:text-accent-primary transition-transform duration-150 group-hover:translate-x-0.5 shrink-0" aria-hidden="true">→</span>
    </a>

    <a
      href={siteConfig.links.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center justify-between gap-4 border border-border-subtle bg-canvas p-5 shadow-xs transition-card hover:-translate-y-0.5 hover:border-accent-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
    >
      <div class="min-w-0 space-y-1">
        <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted">
          {t('contact.linkedinLabel')}
        </p>
        <p class="text-sm font-medium text-fg-primary group-hover:text-accent-primary transition-colors truncate">
          LinkedIn · Adrián Perdomo
        </p>
      </div>
      <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
      <span class="text-fg-muted group-hover:text-accent-primary transition-transform duration-150 group-hover:translate-x-0.5 shrink-0" aria-hidden="true">↗</span>
    </a>

    <a
      href={siteConfig.links.github}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center justify-between gap-4 border border-border-subtle bg-canvas p-5 shadow-xs transition-card hover:-translate-y-0.5 hover:border-accent-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
    >
      <div class="min-w-0 space-y-1">
        <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted">
          {t('contact.githubLabel')}
        </p>
        <p class="text-sm font-medium text-fg-primary group-hover:text-accent-primary transition-colors truncate">
          github.com/Perdomazo
        </p>
      </div>
      <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
      <span class="text-fg-muted group-hover:text-accent-primary transition-transform duration-150 group-hover:translate-x-0.5 shrink-0" aria-hidden="true">↗</span>
    </a>
  </div>

  <!-- Discreet, Compact Consulting Banner -->
  <aside
    class="mt-6 border border-border-subtle bg-canvas-subtle p-5 sm:px-7 sm:py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
    aria-label={t('contact.consultingBadge')}
    data-consulting-banner
  >
    <div class="space-y-1">
      <p class="text-[10px] font-mono-tech uppercase tracking-widest text-accent-primary font-semibold">
        {t('contact.consultingBadge')}
      </p>
      <p class="text-sm text-fg-secondary leading-relaxed">
        {t('contact.consultingText')}
      </p>
    </div>

    <a
      href={consultingHref}
      class="group inline-flex items-center justify-center gap-2 border border-accent-primary/35 bg-canvas px-4 py-2.5 text-xs font-mono-tech uppercase tracking-wider text-accent-primary hover:bg-accent-primary hover:text-white transition-colors shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
    >
      <span>{t('contact.consultingLink')}</span>
      <span class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
    </a>
  </aside>
</section>
