---
import { siteConfig } from '../config/site';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sectionId = locale === 'en' ? 'contact' : 'contacto';
const consultingHref = locale === 'en' ? '/en/consulting/' : '/consultoria/';
---

<section
  id={sectionId}
  data-scroll-module
  class="relative w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-12 sm:pt-24 pb-16 sm:pb-28 border-t border-border-subtle"
  aria-labelledby="contact-heading"
>
  <!-- 06 / CONTACTO: Left Column (Header + LinkedIn & GitHub Boxes) + Right Column (Compact Automated Form Box) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start" data-contact-grid>
    <!-- Left Column: Title, Intro, LinkedIn & GitHub Boxes -->
    <div class="lg:col-span-5 space-y-5 sm:space-y-6" data-section-header>
      <div class="space-y-2.5 sm:space-y-3">
        <p class="text-xs font-mono-tech uppercase tracking-widest text-accent-primary font-semibold">
          {t('contact.sectionIndex')}
        </p>
        <h2
          id="contact-heading"
          class="text-2xl sm:text-4xl font-normal tracking-[-0.03em] leading-tight text-fg-primary"
        >
          {t('contact.title')}
        </h2>
        <p class="text-sm sm:text-base text-fg-secondary leading-relaxed text-pretty">
          {t('contact.subtitle')}
        </p>
      </div>

      <!-- Maintained LinkedIn & GitHub Interactive Boxes -->
      <div class="space-y-2.5 sm:space-y-3 pt-1">
        <a
          href={siteConfig.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between gap-4 border border-border-subtle bg-canvas p-4 sm:p-5 shadow-xs transition-card hover:-translate-y-0.5 hover:border-accent-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
        >
          <div class="min-w-0 space-y-1">
            <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted">
              {t('contact.linkedinLabel')}
            </p>
            <p class="text-sm font-medium text-fg-primary group-hover:text-accent-primary transition-colors truncate">
              LinkedIn · Adrián Perdomo
            </p>
          </div>
          <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
          <span class="text-fg-muted group-hover:text-accent-primary transition-transform duration-150 group-hover:translate-x-0.5 shrink-0" aria-hidden="true">↗</span>
        </a>

        <a
          href={siteConfig.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between gap-4 border border-border-subtle bg-canvas p-4 sm:p-5 shadow-xs transition-card hover:-translate-y-0.5 hover:border-accent-primary/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
        >
          <div class="min-w-0 space-y-1">
            <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted">
              {t('contact.githubLabel')}
            </p>
            <p class="text-sm font-medium text-fg-primary group-hover:text-accent-primary transition-colors truncate">
              github.com/Perdomazo
            </p>
          </div>
          <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
          <span class="text-fg-muted group-hover:text-accent-primary transition-transform duration-150 group-hover:translate-x-0.5 shrink-0" aria-hidden="true">↗</span>
        </a>
      </div>

      <!-- Subtle Direct Email Fallback -->
      <div class="pt-1 text-xs font-mono-tech text-fg-muted break-words">
        <span>{t('contact.emailLabel')}: </span>
        <a
          href={`mailto:${siteConfig.links.email}`}
          class="text-fg-primary hover:text-accent-primary underline underline-offset-4 transition-colors"
        >
          {siteConfig.links.email}
        </a>
      </div>
    </div>

    <!-- Right Column: Compact Automated Email Form Box -->
    <div class="lg:col-span-7 border border-border-subtle bg-canvas-subtle/70 p-5 sm:p-8 shadow-xs">
      <form
        id="home-contact-form"
        class="grid sm:grid-cols-2 gap-4"
        data-form-error={t('contact.form.error')}
        data-form-loading={t('contact.form.loading')}
        data-form-success={t('contact.form.success')}
        data-form-failure={t('contact.form.failure')}
        data-form-network-error={t('contact.form.networkError')}
        data-locale={locale}
      >
        <label class="sr-only" aria-hidden="true">
          {t('contact.form.trap')}
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>

        <label class="block text-xs text-fg-secondary">
          {t('contact.form.name')}
          <span class="text-status-active" aria-hidden="true"> *</span>
          <input
            name="name"
            autocomplete="name"
            required
            class="mt-1.5 block w-full border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
          />
        </label>

        <label class="block text-xs text-fg-secondary">
          {t('contact.form.email')}
          <span class="text-status-active" aria-hidden="true"> *</span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            class="mt-1.5 block w-full border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
          />
        </label>

        <label class="sm:col-span-2 block text-xs text-fg-secondary">
          {t('contact.form.subject')}
          <input
            name="business"
            autocomplete="organization"
            class="mt-1.5 block w-full border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
          />
        </label>

        <label class="sm:col-span-2 block text-xs text-fg-secondary">
          {t('contact.form.message')}
          <span class="text-status-active" aria-hidden="true"> *</span>
          <textarea
            name="message"
            required
            rows="3"
            class="mt-1.5 block w-full resize-y border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
          ></textarea>
        </label>

        <div class="sm:col-span-2 pt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <button
            type="submit"
            class="inline-flex w-full sm:w-auto justify-center items-center gap-2.5 bg-accent-primary px-5 py-3.5 sm:py-3 text-xs font-sans font-medium uppercase tracking-wider text-white shadow-xs transition-all hover:bg-accent-interactive hover:shadow-md disabled:cursor-wait disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
          >
            <span data-home-submit-label>{t('contact.form.submit')}</span>
            <span aria-hidden="true">↗</span>
          </button>
          <p class="text-xs font-mono-tech text-fg-muted">{t('contact.form.privacy')}</p>
        </div>

        <p
          id="home-contact-form-status"
          class="sm:col-span-2 min-h-5 text-xs text-fg-secondary"
          role="status"
          aria-live="polite"
        ></p>
      </form>
    </div>
  </div>

  <!-- Separated, Prominent Closing Showcase Banner: PERDOMOPRO · CONSULTORÍA PYME -->
  <div class="mt-14 sm:mt-28 pt-10 sm:pt-16 border-t border-border-subtle">
    <aside
      class="relative overflow-hidden border border-accent-primary/35 bg-gradient-to-br from-accent-subtle via-white to-accent-subtle/80 p-6 sm:p-10 lg:p-12 shadow-md"
      aria-label={t('contact.consultingBadge')}
      data-consulting-banner
    >
      <!-- Top Violet Accent Strip -->
      <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-accent-primary via-accent-interactive to-accent-primary/40" aria-hidden="true"></div>
      <!-- Subtle Corner Ambient Glow -->
      <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent-primary/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-8 space-y-3.5 sm:space-y-4">
          <span class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 border border-accent-primary/25 bg-white text-accent-primary font-mono-tech text-[10px] sm:text-[11px] uppercase tracking-widest font-semibold shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-accent-primary shrink-0" aria-hidden="true"></span>
            <span>{t('contact.consultingBadge')}</span>
          </span>

          <h3 class="text-xl sm:text-3xl lg:text-[2.15rem] font-normal tracking-[-0.03em] leading-[1.18] sm:leading-[1.15] text-fg-primary text-balance">
            {t('contact.consultingText')}
          </h3>

          <p class="text-sm sm:text-base text-fg-secondary leading-relaxed max-w-2xl">
            {t('contact.consultingDesc')}
          </p>

          <div class="pt-0.5 sm:pt-1 flex flex-wrap gap-1.5 sm:gap-2">
            <span class="px-2.5 py-1 text-[11px] font-mono-tech border border-accent-primary/20 bg-white/90 text-fg-primary">
              {t('contact.consultingTag1')}
            </span>
            <span class="px-2.5 py-1 text-[11px] font-mono-tech border border-accent-primary/20 bg-white/90 text-fg-primary">
              {t('contact.consultingTag2')}
            </span>
            <span class="px-2.5 py-1 text-[11px] font-mono-tech border border-accent-primary/20 bg-white/90 text-fg-primary">
              {t('contact.consultingTag3')}
            </span>
          </div>
        </div>

        <div class="lg:col-span-4 flex lg:justify-end">
          <a
            href={consultingHref}
            class="group inline-flex w-full sm:w-auto items-center justify-center gap-3 bg-accent-primary px-6 sm:px-7 py-3.5 sm:py-4 text-xs sm:text-sm font-sans font-medium uppercase tracking-wider text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-interactive hover:shadow-lg hover:shadow-accent-primary/15 active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
          >
            <span>{t('contact.consultingLink')}</span>
            <span class="transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </aside>
  </div>
</section>

<script>
  function setupHomeContactForm() {
    const form = document.querySelector<HTMLFormElement>('#home-contact-form');
    const status = document.querySelector<HTMLElement>('#home-contact-form-status');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    if (!form || !status || !submitBtn || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const values = new FormData(form);
      const name = String(values.get('name') ?? '').trim();
      const email = String(values.get('email') ?? '').trim();
      const business = String(values.get('business') ?? '').trim();
      const message = String(values.get('message') ?? '').trim();
      const isEn = form.dataset.locale === 'en';

      if (!name || !email || !message) {
        status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
        status.textContent = form.dataset.formError ?? 'Faltan campos obligatorios.';
        return;
      }

      const submitLabel = submitBtn.querySelector<HTMLElement>('[data-home-submit-label]');
      const originalBtnText = submitLabel?.textContent ?? '';
      submitBtn.setAttribute('aria-busy', 'true');
      if (submitLabel) submitLabel.textContent = form.dataset.formLoading ?? 'Enviando…';
      submitBtn.disabled = true;
      status.textContent = '';
      status.className = 'sm:col-span-2 min-h-5 text-xs text-fg-secondary';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            nombre: name,
            correo: email,
            negocio: business,
            telefono: '',
            preferencia: isEn ? 'Email' : 'Correo',
            descripcion: message,
            servicio: isEn ? 'Portfolio Contact' : 'Contacto Perfil Principal',
            sitioWeb: String(values.get('website') ?? ''),
            idioma: form.dataset.locale ?? 'es-MX',
          }),
        });

        await response.json().catch(() => null);
        if (response.ok) {
          form.reset();
          status.className = 'sm:col-span-2 min-h-5 text-xs text-emerald-700 font-medium';
          status.textContent = form.dataset.formSuccess ?? 'Mensaje enviado correctamente.';
        } else {
          status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
          status.textContent = form.dataset.formFailure ?? 'No se pudo enviar el mensaje.';
        }
      } catch {
        status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
        status.textContent = form.dataset.formNetworkError ?? 'Error de conexión.';
      } finally {
        submitBtn.removeAttribute('aria-busy');
        if (submitLabel) submitLabel.textContent = originalBtnText;
        submitBtn.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', setupHomeContactForm);
  setupHomeContactForm();
</script>
