---
import { siteConfig } from '../config/site';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import ParticlesBackground from './ParticlesBackground.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projectsHref = locale === 'en' ? '/en/#projects' : '#proyectos';
const contactHref = locale === 'en' ? '/en/#contact' : '#contacto';
const rotatingPhrases = locale === 'en'
  ? ['software and infrastructure.', 'processes and automation.', 'cloud and operations.']
  : ['software e infraestructura.', 'procesos y automatización.', 'cloud y operación.'];
---

<section
  id="hero"
  data-scroll-module
  class="relative isolate w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-10 sm:pt-16 pb-16 sm:pb-24"
  aria-labelledby="hero-heading"
>
  <ParticlesBackground id="perdomopro-particles" />

  <!-- Central Editorial Grid (Asymmetric) -->
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start pointer-events-none">
    <!-- Primary Content Column -->
    <div class="lg:col-span-7 xl:col-span-8 space-y-6 sm:space-y-8">
      <!-- Single Subtle Eyebrow Identifier -->
      <div class="inline-flex items-center gap-2.5 text-xs font-mono-tech tracking-wider uppercase text-fg-primary font-medium" data-hero-meta="category">
        <span class="inline-block w-2 h-2 rounded-full bg-status-active" aria-hidden="true"></span>
        <span>{t('hero.technicalPillars')}</span>
      </div>

      <!-- Main Headline -->
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl md:text-6xl lg:text-[4.15rem] font-normal tracking-[-0.035em] leading-[1.08] text-fg-primary max-w-3xl text-balance"
        data-hero-headline
      >
        <span>{t('hero.headlinePrefix')}</span>{' '}
        <span class="font-medium text-fg-primary underline decoration-border-muted underline-offset-8 decoration-1">
          <span class="sr-only">{t('hero.headlineHighlight')}</span>
          <span
            aria-hidden="true"
            data-word-morph
            data-word-morph-phrases={JSON.stringify(rotatingPhrases)}
            class="inline-block min-h-[2.1em] transition-[opacity,transform] duration-300 ease-out motion-reduce:transition-none"
          >{rotatingPhrases[0]}</span>
        </span>
      </h1>

      <!-- Engineering CTAs & Quick Recruiter Links -->
      <div class="space-y-5 pt-1 sm:pt-2 pointer-events-auto" data-hero-cta>
        <div class="flex flex-wrap items-center gap-3.5">
          <a
            href={contactHref}
            class="group inline-flex items-center gap-3 bg-accent-primary text-white px-6 py-3.5 text-xs font-sans font-medium tracking-wider uppercase shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-accent-interactive hover:shadow-md hover:shadow-accent-primary/10 active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
          >
            <span>{t('hero.cta.contact')}</span>
            <span class="transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>

          <a
            href={projectsHref}
            class="group inline-flex items-center gap-3 border border-border-subtle bg-white/80 backdrop-blur-[2px] hover:border-accent-primary text-fg-primary px-6 py-3.5 text-xs font-sans font-medium tracking-wider uppercase transition-all duration-200 ease-out hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
          >
            <span>{t('hero.cta.projects')}</span>
            <span class="text-fg-muted group-hover:text-fg-primary transition-colors duration-150" aria-hidden="true">↓</span>
          </a>
        </div>

        <!-- Direct Social & Contact Channels -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono-tech text-fg-secondary">
          <a
            href={siteConfig.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-accent-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
          >
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
            </svg>
            <span>GitHub</span>
            <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
            <span aria-hidden="true">↗</span>
          </a>

          <span class="text-border-muted" aria-hidden="true">·</span>

          <a
            href={siteConfig.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 hover:text-accent-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
          >
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
            </svg>
            <span>LinkedIn</span>
            <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
            <span aria-hidden="true">↗</span>
          </a>

          <span class="text-border-muted hidden sm:inline" aria-hidden="true">·</span>

          <a
            href={`mailto:${siteConfig.links.email}`}
            class="inline-flex items-center gap-1.5 hover:text-accent-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
          >
            <span>{siteConfig.links.email}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Secondary Editorial & Metadata Column -->
    <div class="lg:col-span-5 xl:col-span-4 space-y-6 lg:pt-8">
      <p class="text-base sm:text-lg text-fg-primary font-normal leading-relaxed text-pretty" data-hero-desc>
        {t('hero.description')}
      </p>

      <dl class="border-t border-border-subtle pt-5 space-y-3 text-xs font-mono-tech" data-hero-meta="spec-list">
        <div class="flex justify-between items-baseline gap-4 py-1.5 border-b border-border-subtle/60">
          <dt class="text-fg-secondary uppercase tracking-wider shrink-0">{t('hero.meta.roleTitle')}</dt>
          <dd class="text-fg-primary font-semibold text-right">{t('hero.meta.roleValue')}</dd>
        </div>

        <div class="flex justify-between items-baseline gap-4 py-1.5 border-b border-border-subtle/60">
          <dt class="text-fg-secondary uppercase tracking-wider shrink-0">{t('hero.meta.educationTitle')}</dt>
          <dd class="text-fg-primary font-semibold text-right">{t('hero.meta.educationValue')}</dd>
        </div>

        <div class="flex justify-between items-baseline gap-4 py-1.5 border-b border-border-subtle/60">
          <dt class="text-fg-secondary uppercase tracking-wider shrink-0">{t('hero.meta.locationTitle')}</dt>
          <dd class="text-fg-primary font-medium text-right">{t('hero.meta.locationValue')}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<script>
  function setupWordMorph() {
    const element = document.querySelector<HTMLElement>('[data-word-morph]');
    if (!element || element.dataset.wordMorphInitialized === 'true') return;
    element.dataset.wordMorphInitialized = 'true';

    const phrases = JSON.parse(element.dataset.wordMorphPhrases ?? '[]') as string[];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (phrases.length < 2 || reducedMotion.matches) return;

    let index = 0;
    let timer = 0;
    const rotate = () => {
      if (reducedMotion.matches) return;
      element.classList.add('translate-y-1', 'opacity-60');
      timer = window.setTimeout(() => {
        index = (index + 1) % phrases.length;
        element.textContent = phrases[index];
        element.classList.remove('translate-y-1');
        requestAnimationFrame(() => element.classList.remove('opacity-60'));
        timer = window.setTimeout(rotate, 3400);
      }, 300);
    };

    timer = window.setTimeout(rotate, 3400);
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) {
        window.clearTimeout(timer);
        element.classList.remove('translate-y-1', 'opacity-60');
        element.textContent = phrases[0];
      }
    }, { once: true });
  }

  document.addEventListener('astro:page-load', setupWordMorph);
  setupWordMorph();
</script>
