---
import { siteConfig } from '../config/site';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const projectsHref = locale === 'en' ? '/en/#projects' : '#proyectos';
const contactHref = locale === 'en' ? '/en/#contact' : '#contacto';
const rotatingPhrases = locale === 'en'
  ? ['software and infrastructure.', 'processes and automation.', 'cloud and operations.']
  : ['software e infraestructura.', 'procesos y automatización.', 'cloud y operación.'];
---

<section
  id="hero"
  data-scroll-module
  class="relative w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-6 sm:pt-10 pb-3 sm:pb-4 min-h-[calc(100vh-5rem)] flex flex-col justify-between"
  aria-labelledby="hero-heading"
>
  <!-- Top Editorial Technical Metadata Strip -->
  <header
    class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono-tech tracking-wider uppercase text-fg-secondary p-4 sm:p-5 border border-border-subtle bg-canvas-subtle shadow-sm"
    data-hero-meta="top"
  >
    <div class="flex items-center gap-3">
      <span class="text-fg-muted">{t('hero.sectionIndex')}</span>
      <span class="text-border-muted" aria-hidden="true">/</span>
      <span class="text-fg-primary font-medium">{siteConfig.brand}</span>
    </div>

    <div class="flex flex-wrap items-center gap-4 sm:gap-6">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-status-active" aria-hidden="true"></span>
        <span class="text-fg-primary font-medium">{t('hero.statusIndicator')}</span>
      </div>
    </div>
  </header>

  <!-- Central Editorial Grid (Asymmetric) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start my-auto py-10 lg:py-16">
    <!-- Primary Content Column -->
    <div class="lg:col-span-7 xl:col-span-8 space-y-6 sm:space-y-8">
      <!-- Technical Focus Pill -->
      <div class="flex items-center gap-2 text-xs font-mono-tech tracking-wider uppercase text-fg-secondary" data-hero-meta="category">
        <span class="w-1.5 h-1.5 bg-fg-primary" aria-hidden="true"></span>
        <span>{t('hero.technicalPillars')}</span>
      </div>

      <!-- Main Headline -->
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl md:text-6xl lg:text-[4.15rem] font-light tracking-[-0.035em] leading-[1.08] text-fg-primary max-w-3xl text-balance"
        data-hero-headline
      >
        <span>{t('hero.headlinePrefix')}</span>{' '}
        <span class="font-medium text-fg-primary underline decoration-border-muted underline-offset-8 decoration-1">
          <span class="sr-only">{t('hero.headlineHighlight')}</span>
          <span
            aria-hidden="true"
            data-word-morph
            data-word-morph-phrases={JSON.stringify(rotatingPhrases)}
            class="inline-block min-h-[2.1em] transition-[opacity,transform] duration-300 ease-out motion-reduce:transition-none"
          >{rotatingPhrases[0]}</span>
        </span>
      </h1>

      <!-- Editorial CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-2 sm:pt-4" data-hero-cta>
        <a
          href={contactHref}
          class="group inline-flex items-center gap-3 bg-accent-primary text-white px-6 py-3.5 text-xs font-sans font-medium tracking-wider uppercase shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md hover:shadow-accent-primary/10 active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
        >
          <span>{t('hero.cta.contact')}</span>
          <span class="transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>

        <a
          href={projectsHref}
          class="group inline-flex items-center gap-3 border border-border-subtle hover:border-accent-primary text-fg-primary px-6 py-3.5 text-xs font-sans font-medium tracking-wider uppercase transition-all duration-200 ease-out hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
        >
          <span>{t('hero.cta.projects')}</span>
          <span class="text-fg-muted group-hover:text-fg-primary transition-colors duration-150" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <!-- Secondary Editorial & Metadata Column -->
    <div class="lg:col-span-5 xl:col-span-4 space-y-8 lg:pt-3">
      <!-- Concise Positioning Description -->
      <p class="text-base sm:text-lg text-fg-secondary font-normal leading-relaxed text-pretty" data-hero-desc>
        {t('hero.description')}
      </p>

      <!-- Technical Specifier Breakdown -->
      <dl class="border-t border-border-subtle pt-6 space-y-4 text-xs font-mono-tech" data-hero-meta="spec-list">
        <div class="flex justify-between items-baseline gap-4 py-1.5 border-b border-border-subtle/60">
          <dt class="text-fg-muted uppercase tracking-wider">{t('hero.meta.roleTitle')}</dt>
          <dd class="text-fg-primary font-medium text-right">{t('hero.meta.roleValue')}</dd>
        </div>

        <div class="flex justify-between items-baseline gap-4 py-1.5 border-b border-border-subtle/60">
          <dt class="text-fg-muted uppercase tracking-wider">{t('hero.meta.educationTitle')}</dt>
          <dd class="text-fg-primary font-medium text-right">{t('hero.meta.educationValue')}</dd>
        </div>

      </dl>
    </div>
  </div>

  <!-- Bottom Editorial Metadata & Visual Anchor -->
  <footer
    class="border-t border-border-subtle pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs font-mono-tech text-fg-muted"
    data-hero-meta="bottom"
  >
    <div class="flex items-center gap-2">
      <span class="text-fg-primary uppercase font-medium">{siteConfig.author.name}</span>
      <span class="text-border-muted">•</span>
      <span>{siteConfig.author.education}</span>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-fg-secondary uppercase tracking-widest text-[11px]">{locale === 'es-MX' ? 'EXPLORAR' : 'EXPLORE'}</span>
      <span class="text-fg-muted" aria-hidden="true">↓</span>
    </div>
  </footer>
</section>

<script>
  function setupWordMorph() {
    const element = document.querySelector<HTMLElement>('[data-word-morph]');
    if (!element || element.dataset.wordMorphInitialized === 'true') return;
    element.dataset.wordMorphInitialized = 'true';

    const phrases = JSON.parse(element.dataset.wordMorphPhrases ?? '[]') as string[];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (phrases.length < 2 || reducedMotion.matches) return;

    let index = 0;
    let timer = 0;
    const rotate = () => {
      if (reducedMotion.matches) return;
      element.classList.add('translate-y-2', 'opacity-0');
      timer = window.setTimeout(() => {
        index = (index + 1) % phrases.length;
        element.textContent = phrases[index];
        element.classList.remove('translate-y-2');
        requestAnimationFrame(() => element.classList.remove('opacity-0'));
        timer = window.setTimeout(rotate, 3400);
      }, 280);
    };

    timer = window.setTimeout(rotate, 3400);
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) {
        window.clearTimeout(timer);
        element.classList.remove('translate-y-2', 'opacity-0');
        element.textContent = phrases[0];
      }
    }, { once: true });
  }

  document.addEventListener('astro:page-load', setupWordMorph);
  setupWordMorph();
</script>
