---
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const stackCategories = [
  {
    num: '01',
    nameKey: 'stack.cat.dev' as const,
    descKey: 'stack.cat.devDesc' as const,
    technologies: ['TypeScript', 'JavaScript', 'Python', 'React', 'React Native', 'Astro'],
    indicator: 'code',
  },
  {
    num: '02',
    nameKey: 'stack.cat.cloud' as const,
    descKey: 'stack.cat.cloudDesc' as const,
    technologies: ['Azure', 'AWS', 'Azure Static Web Apps'],
    indicator: 'cloud',
  },
  {
    num: '03',
    nameKey: 'stack.cat.infra' as const,
    descKey: 'stack.cat.infraDesc' as const,
    technologies: ['Linux', 'Git', 'GitHub', 'Networking', 'Servers'],
    indicator: 'infra',
  },
  {
    num: '04',
    nameKey: 'stack.cat.ai' as const,
    descKey: 'stack.cat.aiDesc' as const,
    technologies: ['LLMs', 'AI Agents', 'Local AI', 'Automation', 'AI integrations'],
    indicator: 'ai',
  },
];
---

<section
  id="stack"
  class="relative w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-20 sm:py-28 border-t border-border-subtle"
  aria-labelledby="stack-heading"
>
  <!-- Section Header Strip -->
  <header class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono-tech tracking-wider uppercase text-fg-secondary pb-6 mb-12 sm:mb-16 border-b border-border-subtle">
    <div class="flex items-center gap-3">
      <span class="text-fg-muted">{t('stack.sectionIndex')}</span>
      <span class="text-border-muted" aria-hidden="true">/</span>
      <span class="text-fg-primary font-medium">{t('stack.label')}</span>
    </div>
    <div class="text-xs font-mono-tech text-fg-muted">
      <span>{locale === 'es-MX' ? 'HERRAMIENTAS & ECOISTEMA' : 'TOOLING & ECOSYSTEM'}</span>
    </div>
  </header>

  <!-- Section Title & Intro -->
  <div class="max-w-3xl mb-16 sm:mb-20 space-y-4">
    <h2
      id="stack-heading"
      class="text-3xl sm:text-4xl md:text-5xl font-light tracking-[-0.03em] leading-tight text-fg-primary"
    >
      {t('stack.title')}
    </h2>
    <p class="text-base sm:text-lg text-fg-secondary font-normal leading-relaxed text-pretty">
      {t('stack.subtitle')}
    </p>
  </div>

  <!-- Editorial Stack Grid: 4 Clean Columns / Categories -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 border-t border-border-subtle pt-10">
    {stackCategories.map((cat) => (
      <article class="space-y-6 flex flex-col justify-between group">
        <!-- Top: Number & Category Title -->
        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-border-subtle/70 pb-3">
            <span class="text-xs font-mono-tech text-fg-muted">{cat.num}</span>
            <span class="w-1.5 h-1.5 bg-fg-primary rounded-none transition-transform group-hover:scale-125" aria-hidden="true"></span>
          </div>

          <h3 class="text-xl sm:text-2xl font-light tracking-tight text-fg-primary">
            {t(cat.nameKey)}
          </h3>

          <p class="text-xs sm:text-sm text-fg-secondary font-normal leading-relaxed text-pretty">
            {t(cat.descKey)}
          </p>
        </div>

        <!-- Technologies List (Typographic & Structured) -->
        <div class="pt-6 border-t border-border-subtle/60">
          <ul class="space-y-2 list-none p-0 m-0 text-sm font-mono-tech">
            {cat.technologies.map((tech) => (
              <li class="flex items-center justify-between py-1 border-b border-border-subtle/40 text-fg-primary">
                <span>{tech}</span>
                <span class="text-[10px] text-fg-muted group-hover:text-fg-secondary transition-colors" aria-hidden="true">
                  +
                </span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>

  <!-- Footnote -->
  <footer class="mt-16 pt-6 border-t border-border-subtle flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono-tech text-fg-muted">
    <p>{t('stack.footnote')}</p>
    <span class="text-fg-primary uppercase font-medium">ECOSYSTEM OVER LOGOS</span>
  </footer>
</section>
