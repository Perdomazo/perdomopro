---
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const stackColumns = [
  {
    title: t('stack.col1.title'),
    items:
      locale === 'en'
        ? [
            'Microsoft Azure',
            'AWS',
            'Linux',
            'Windows Server',
            'Docker',
            'Azure Static Web Apps',
            'Networking & DNS',
            'Virtualization',
          ]
        : [
            'Microsoft Azure',
            'AWS',
            'Linux',
            'Windows Server',
            'Docker',
            'Azure Static Web Apps',
            'Redes & DNS',
            'Virtualización',
          ],
  },
  {
    title: t('stack.col2.title'),
    items: ['Java 21', 'Python', 'TypeScript', 'C / C++', 'PowerShell', 'SQL (MySQL / Oracle)'],
  },
  {
    title: t('stack.col3.title'),
    items: [
      'Spring Boot',
      'JPA / Hibernate',
      'Astro',
      'Tailwind CSS',
      'GitHub Actions (CI/CD)',
      'Git & GitHub',
      'Swagger / OpenAPI',
    ],
  },
];
---

<section
  id="stack"
  data-scroll-module
  class="relative w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24 border-t border-border-subtle"
  aria-labelledby="stack-heading"
>
  <!-- Clean Single-Level Section Header -->
  <div class="max-w-3xl mb-10 sm:mb-14 space-y-3" data-section-header>
    <p class="text-xs font-mono-tech uppercase tracking-widest text-accent-primary font-semibold">
      {t('stack.sectionIndex')}
    </p>
    <h2
      id="stack-heading"
      class="text-3xl sm:text-4xl font-normal tracking-[-0.03em] leading-tight text-fg-primary"
    >
      {t('stack.title')}
    </h2>
    <p class="text-base text-fg-secondary leading-relaxed text-pretty">
      {t('stack.subtitle')}
    </p>
  </div>

  <!-- 3-Column Scannable Skills & Technologies Matrix -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {stackColumns.map((col, idx) => (
      <article class="flex flex-col justify-between border border-border-subtle bg-canvas p-6 sm:p-7 shadow-xs transition-card hover:border-accent-primary/35 hover:shadow-md">
        <div>
          <div class="flex items-center justify-between gap-3 pb-4 border-b border-border-subtle/70">
            <h3 class="text-base sm:text-lg font-medium text-fg-primary tracking-tight">
              {col.title}
            </h3>
            <span class="text-xs font-mono-tech text-accent-primary font-semibold">
              0{idx + 1}
            </span>
          </div>

          <ul class="mt-5 flex flex-wrap gap-2 list-none p-0 m-0">
            {col.items.map((tech) => (
              <li class="px-2.5 py-1 text-xs font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-primary hover:border-accent-primary/40 hover:bg-accent-subtle transition-colors">
                {tech}
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
