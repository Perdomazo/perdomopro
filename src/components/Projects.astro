---
import { projectsData } from '../data/projects';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sectionId = locale === 'en' ? 'projects' : 'proyectos';
---

<section
  id={sectionId}
  class="relative w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-20 sm:py-28 border-t border-border-subtle"
  aria-labelledby="projects-heading"
>
  <!-- Section Header Strip -->
  <header class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono-tech tracking-wider uppercase text-fg-secondary pb-6 mb-12 sm:mb-16 border-b border-border-subtle">
    <div class="flex items-center gap-3">
      <span class="text-fg-muted">{t('projects.sectionIndex')}</span>
      <span class="text-border-muted" aria-hidden="true">/</span>
      <span class="text-fg-primary font-medium">{locale === 'es-MX' ? 'REGISTRO DE INICIATIVAS' : 'WORK LOG'}</span>
    </div>
    <div class="text-xs font-mono-tech text-fg-muted">
      <span>{locale === 'es-MX' ? 'CLASIFICACIÓN FACTUAL & TRANSPARENTE' : 'FACTUAL & TRANSPARENT LOG'}</span>
    </div>
  </header>

  <!-- Section Title & Narrative Intro -->
  <div class="max-w-3xl mb-16 sm:mb-20 space-y-4">
    <h2
      id="projects-heading"
      class="text-3xl sm:text-4xl md:text-5xl font-light tracking-[-0.03em] leading-tight text-fg-primary"
    >
      {t('projects.title')}
    </h2>
    <p class="text-base sm:text-lg text-fg-secondary font-normal leading-relaxed text-pretty">
      {t('projects.subtitle')}
    </p>
  </div>

  <!-- Editorial Projects Stack -->
  <div class="space-y-16 sm:space-y-24">
    {projectsData.map((project, idx) => {
      const content = project.content[locale];
      const isEven = idx % 2 === 1;

      return (
        <article
          class="border-t border-border-subtle pt-10 sm:pt-14 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start group"
          aria-labelledby={`project-title-${project.id}`}
        >
          <!-- Left Column: Number, Type & Visual Architecture Schematic -->
          <div class={`lg:col-span-5 space-y-6 ${isEven ? 'lg:order-2' : ''}`}>
            <!-- Project Header Identifier -->
            <div class="flex items-center justify-between border-b border-border-subtle/70 pb-4">
              <span class="text-4xl sm:text-5xl font-light font-mono-tech text-fg-primary">
                {project.number}
              </span>
              <span class="text-xs font-mono-tech px-2.5 py-1 border border-border-subtle text-fg-primary bg-canvas-subtle">
                {content.typeBadge}
              </span>
            </div>

            <!-- Conceptual Architecture Pipeline Diagram -->
            <div class="p-6 bg-canvas-subtle border border-border-subtle space-y-4">
              <div class="flex items-center justify-between text-xs font-mono-tech text-fg-muted">
                <span class="uppercase tracking-wider">{t('projects.flowLabel')}</span>
                <span class="w-1.5 h-1.5 rounded-full bg-fg-primary" aria-hidden="true"></span>
              </div>

              <!-- Pipeline Flow Visualization -->
              <ol class="space-y-2 font-mono-tech text-xs list-none p-0 m-0">
                {project.diagramFlow.map((step, sIdx) => (
                  <li class="flex items-center gap-3">
                    <span class="text-fg-muted text-[10px]">0{sIdx + 1}</span>
                    <span class="h-px w-3 bg-border-muted" aria-hidden="true"></span>
                    <span class="text-fg-primary font-medium">{step}</span>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Honest Status Indicator -->
            <div class="flex items-center gap-2 text-xs font-mono-tech text-fg-secondary">
              <span class="inline-block w-2 h-2 rounded-full bg-status-active" aria-hidden="true"></span>
              <span class="font-medium text-fg-primary">{content.statusLabel}</span>
            </div>
          </div>

          <!-- Right Column: Title, Category, Narrative Context & Tech Stack -->
          <div class={`lg:col-span-7 space-y-6 ${isEven ? 'lg:order-1' : ''}`}>
            <div class="space-y-2">
              <p class="text-xs font-mono-tech uppercase tracking-wider text-fg-muted">
                {content.category}
              </p>
              <h3
                id={`project-title-${project.id}`}
                class="text-2xl sm:text-3xl lg:text-4xl font-light tracking-tight text-fg-primary"
              >
                {content.title}
              </h3>
              <p class="text-sm sm:text-base font-normal text-fg-primary/80">
                {content.tagline}
              </p>
            </div>

            <!-- Description -->
            <p class="text-base sm:text-lg text-fg-secondary font-normal leading-relaxed text-pretty">
              {content.description}
            </p>

            <!-- Technical Context Breakdown -->
            <div class="border-t border-border-subtle/70 pt-4 space-y-2">
              <h4 class="text-xs font-mono-tech text-fg-muted uppercase tracking-wider">
                {t('projects.contextLabel')}
              </h4>
              <p class="text-sm text-fg-secondary font-normal leading-relaxed">
                {content.context}
              </p>
            </div>

            <!-- Technologies Applied -->
            <div class="space-y-3 pt-2">
              <h4 class="text-xs font-mono-tech text-fg-muted uppercase tracking-wider">
                {t('projects.techLabel')}
              </h4>
              <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
                {project.technologies.map((tech) => (
                  <li>
                    <span class="inline-block px-2.5 py-1 text-xs font-mono-tech border border-border-subtle bg-canvas text-fg-primary">
                      {tech}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- External Link if available -->
            {project.href && (
              <div class="pt-4">
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-mono-tech tracking-wider uppercase text-fg-primary hover:text-fg-secondary underline underline-offset-4 transition-colors"
                >
                  <span>{t('projects.visitPlatform')}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <!-- Transparent Honesty Note -->
  <footer class="mt-20 pt-8 border-t border-border-subtle flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-mono-tech text-fg-muted">
    <span>{locale === 'es-MX' ? '* Proyectos etiquetados con absoluta transparencia formativa y técnica.' : '* Projects labeled with rigorous educational and technical transparency.'}</span>
    <span class="text-fg-primary font-medium">PERDOMOPRO // SELECTED WORK</span>
  </footer>
</section>
