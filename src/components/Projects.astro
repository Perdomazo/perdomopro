---
import { projectsData } from '../data/projects';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sectionId = locale === 'en' ? 'projects' : 'proyectos';
const expandLabel = locale === 'en' ? 'Details' : 'Ver detalles';
const collapseLabel = locale === 'en' ? 'Hide' : 'Ocultar';
---

<section
  id={sectionId}
  data-scroll-module
  class="relative w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-9 sm:py-24 border-t border-border-subtle"
  aria-labelledby="projects-heading"
>
  <!-- Clean Single-Level Section Header -->
  <div class="max-w-3xl mb-6 sm:mb-14 space-y-2.5 sm:space-y-3" data-section-header>
    <p class="text-xs font-mono-tech uppercase tracking-widest text-accent-primary font-semibold">
      {t('projects.sectionIndex')}
    </p>
    <h2
      id="projects-heading"
      class="text-2xl sm:text-4xl font-normal tracking-[-0.03em] leading-tight text-fg-primary"
    >
      {t('projects.title')}
    </h2>
    <p class="text-sm sm:text-base text-fg-secondary leading-relaxed text-pretty">
      {t('projects.subtitle')}
    </p>
  </div>

  <!-- Compact Engineering Project Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-5">
    {projectsData.map((project, idx) => {
      const content = project.content[locale];
      const isFullRow = idx === projectsData.length - 1 && projectsData.length % 2 === 1;
      const previewTechs =
        project.technologies.slice(0, 3).join(' · ') +
        (project.technologies.length > 3 ? ` +${project.technologies.length - 3}` : '');
      const panelId = `project-panel-${project.id}`;

      return (
        <article
          data-project-card
          class:list={[
            'group relative flex h-full flex-col justify-between border border-border-subtle bg-canvas p-4 sm:p-7 shadow-xs transition-card sm:hover:-translate-y-0.5 hover:border-accent-primary/40 hover:shadow-md max-sm:data-[open=true]:border-accent-primary/40 max-sm:data-[open=true]:shadow-sm focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-accent-primary overflow-hidden',
            isFullRow && 'md:col-span-2',
          ]}
        >
          <div
            class="absolute inset-x-0 top-0 z-10 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-accent-primary via-accent-interactive to-transparent transition-transform duration-300 group-hover:scale-x-100 max-sm:group-data-[open=true]:scale-x-100"
            aria-hidden="true"
          ></div>

          <!-- Desktop / Tablet View (>= 640px) — 100% Static Editorial Card -->
          <div class="hidden sm:flex sm:h-full sm:flex-col sm:justify-between">
            <div class="space-y-3 sm:space-y-4">
              <!-- Top Metadata Row -->
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2 text-[11px] sm:text-xs font-mono-tech text-fg-muted">
                  <span class="font-semibold text-accent-primary">{project.number}</span>
                  <span class="text-border-muted" aria-hidden="true">/</span>
                  <span class="uppercase tracking-wider">{content.category}</span>
                </div>
                <span class="px-2.5 py-0.5 text-[11px] font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-secondary shrink-0">
                  {content.typeBadge}
                </span>
              </div>

              <!-- Title & Direct 2-Line Summary -->
              <div class="space-y-2">
                <h3 class="text-lg sm:text-2xl font-medium tracking-tight text-fg-primary group-hover:text-accent-primary transition-colors">
                  {content.title}
                </h3>
                <p
                  class:list={[
                    'text-[13.5px] sm:text-[15px] text-fg-secondary leading-relaxed text-pretty',
                    isFullRow && 'max-w-3xl',
                  ]}
                >
                  {content.summary}
                </p>
              </div>

              <!-- Quantifiable / Architectural Impact Pill -->
              <div class="pt-0.5 sm:pt-1">
                <span class="inline-flex items-start gap-2 px-2.5 sm:px-3 py-1.5 border border-accent-primary/20 bg-accent-subtle text-accent-primary text-[11px] sm:text-xs font-mono-tech font-medium leading-snug">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-accent-primary shrink-0" aria-hidden="true"></span>
                  <span>{content.highlightPill}</span>
                </span>
              </div>
            </div>

            <!-- Stack Tags & Action Links -->
            <div class="mt-4 sm:mt-6 pt-3.5 sm:pt-4 border-t border-border-subtle/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4">
              <div class="flex flex-wrap gap-1.5">
                {project.technologies.map((tech) => (
                  <span class="px-2 py-0.5 text-[11px] font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-primary">
                    {tech}
                  </span>
                ))}
              </div>

              {(project.href || project.pipelineHref) && (
                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 shrink-0">
                  {project.href && (
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 py-1 text-xs font-mono-tech uppercase tracking-wider text-fg-primary hover:text-accent-primary underline underline-offset-4 decoration-border-muted hover:decoration-accent-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
                    >
                      <span>{t('projects.repoLink')}</span>
                      <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {project.pipelineHref && (
                    <a
                      href={project.pipelineHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 py-1 text-xs font-mono-tech uppercase tracking-wider text-fg-primary hover:text-accent-primary underline underline-offset-4 decoration-border-muted hover:decoration-accent-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
                    >
                      <span>{t('projects.pipelineLink')}</span>
                      <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>

          <!-- Mobile View (< 640px) — Editorial Expandable Card -->
          <div class="sm:hidden">
            <div class="relative">
              <div class="flex items-start justify-between gap-2.5 mb-2">
                <div class="flex items-center gap-1.5 text-[11px] font-mono-tech text-fg-muted min-w-0 pt-1">
                  <span class="font-semibold text-accent-primary shrink-0">{project.number}</span>
                  <span class="text-border-muted shrink-0" aria-hidden="true">/</span>
                  <span class="uppercase tracking-wider truncate">{content.category}</span>
                </div>

                <span
                  class="inline-flex h-7 w-7 shrink-0 items-center justify-center border border-border-subtle bg-canvas-subtle text-fg-secondary transition-colors duration-200 group-data-[open=true]:border-accent-primary/35 group-data-[open=true]:bg-accent-subtle group-data-[open=true]:text-accent-primary"
                  aria-hidden="true"
                >
                  <svg
                    class="h-3.5 w-3.5 transition-transform duration-300 group-data-[open=true]:rotate-45"
                    viewBox="0 0 14 14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="square"
                  >
                    <path d="M7 2.5v9M2.5 7h9" />
                  </svg>
                </span>
              </div>

              <h3 class="text-[18px] font-medium tracking-tight leading-snug text-fg-primary">
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-expand-trigger
                  class="text-left text-fg-primary transition-colors group-data-[open=true]:text-accent-primary cursor-pointer focus-visible:outline-none after:absolute after:inset-0 after:z-10 after:content-['']"
                >
                  {content.title}
                </button>
              </h3>

              <div class="mt-2.5">
                <span class="inline-flex items-start gap-2 px-2.5 py-1.5 border border-accent-primary/20 bg-accent-subtle text-accent-primary text-[11px] font-mono-tech font-medium leading-snug">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-accent-primary shrink-0" aria-hidden="true"></span>
                  <span>{content.highlightPill}</span>
                </span>
              </div>

              <div class="mt-3 pt-2.5 border-t border-border-subtle/70 flex items-center justify-between gap-3 text-[11px] font-mono-tech">
                <div class="min-w-0 truncate">
                  <span class="text-fg-muted group-data-[open=true]:hidden">{previewTechs}</span>
                  <span class="hidden text-fg-secondary group-data-[open=true]:inline">{content.typeBadge}</span>
                </div>
                <div class="shrink-0 font-medium text-accent-primary">
                  <span class="inline-flex items-center gap-1 group-data-[open=true]:hidden">
                    <span>{expandLabel}</span>
                    <span aria-hidden="true">↓</span>
                  </span>
                  <span class="hidden items-center gap-1 group-data-[open=true]:inline-flex">
                    <span>{collapseLabel}</span>
                    <span aria-hidden="true">↑</span>
                  </span>
                </div>
              </div>
            </div>

            <div id={panelId} class="expandable-panel" data-open="false" inert>
              <div class="expandable-panel-inner">
                <div class="pt-3.5 space-y-3.5">
                  <p class="text-[13.5px] text-fg-secondary leading-relaxed text-pretty">
                    {content.summary}
                  </p>

                  <div class="flex flex-wrap gap-1.5">
                    {project.technologies.map((tech) => (
                      <span class="px-2 py-0.5 text-[11px] font-mono-tech border border-border-subtle bg-canvas-subtle text-fg-primary">
                        {tech}
                      </span>
                    ))}
                  </div>

                  {(project.href || project.pipelineHref) && (
                    <div class="pt-0.5 flex flex-wrap items-center gap-2">
                      {project.href && (
                        <a
                          href={project.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-3 py-2 border border-border-subtle bg-canvas-subtle text-xs font-mono-tech uppercase tracking-wider text-fg-primary hover:border-accent-primary/40 hover:text-accent-primary active:bg-accent-subtle transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
                        >
                          <span>{t('projects.repoLink')}</span>
                          <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
                          <span aria-hidden="true">↗</span>
                        </a>
                      )}
                      {project.pipelineHref && (
                        <a
                          href={project.pipelineHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 px-3 py-2 border border-border-subtle bg-canvas-subtle text-xs font-mono-tech uppercase tracking-wider text-fg-primary hover:border-accent-primary/40 hover:text-accent-primary active:bg-accent-subtle transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
                        >
                          <span>{t('projects.pipelineLink')}</span>
                          <span class="sr-only">{locale === 'en' ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span>
                          <span aria-hidden="true">↗</span>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
