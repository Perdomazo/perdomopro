---
import { projectsData } from '../data/projects';
import { type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sectionId = locale === 'en' ? 'projects' : 'proyectos';
---

<section
  id={sectionId}
  class="relative w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-20 sm:py-28 border-t border-border-subtle"
  aria-labelledby="projects-heading"
>
  <header class="flex flex-wrap items-center justify-between gap-4 text-xs font-mono-tech tracking-wider uppercase text-fg-secondary p-4 sm:p-5 mb-12 sm:mb-16 border border-border-subtle bg-canvas-subtle shadow-sm">
    <div class="flex items-center gap-3">
      <span class="text-fg-muted">{t('projects.sectionIndex')}</span>
      <span class="text-border-muted" aria-hidden="true">/</span>
      <span class="text-fg-primary font-medium">{t('projects.label')}</span>
    </div>
    <span class="text-xs font-mono-tech text-fg-muted">{t('projects.meta')}</span>
  </header>

  <div class="max-w-3xl mb-12 sm:mb-16 space-y-4">
    <h2
      id="projects-heading"
      class="text-3xl sm:text-4xl md:text-5xl font-light tracking-[-0.03em] leading-tight text-fg-primary"
    >
      {t('projects.title')}
    </h2>
    <p class="text-base sm:text-lg text-fg-secondary font-normal leading-relaxed text-pretty">
      {t('projects.subtitle')}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
    {projectsData.map((project) => {
      const content = project.content[locale];
      return (
        <article
          data-project-card
          class="group flex h-full flex-col gap-6 border border-border-subtle bg-canvas-elevated p-6 sm:p-8 shadow-sm transition duration-300 ease-out hover:-translate-y-1 hover:border-border-muted hover:shadow-md focus-within:border-fg-primary"
          aria-labelledby={`project-title-${project.id}`}
        >
          <div class="space-y-5">
            <div class="flex items-center justify-between gap-4">
              <span class="text-4xl sm:text-5xl font-light font-mono-tech text-fg-primary" aria-hidden="true">
                {project.number}
              </span>
              <span class="text-xs font-mono-tech px-2.5 py-1 border border-border-subtle text-fg-primary bg-canvas-subtle">
                {content.typeBadge}
              </span>
            </div>
            <p class="text-xs font-mono-tech uppercase tracking-wider text-fg-muted">{content.category}</p>
            <h3
              id={`project-title-${project.id}`}
              class="text-2xl sm:text-3xl font-light tracking-tight text-fg-primary"
            >
              {content.title}
            </h3>
            <div class="flex flex-wrap gap-2 pt-1">
              {project.technologies.map((tech) => (
                <span class="inline-block px-2.5 py-1 text-xs font-mono-tech border border-border-subtle bg-canvas text-fg-primary">
                  {tech}
                </span>
              ))}
            </div>
            <p class="border-l-2 border-border-muted pl-3 text-xs font-mono-tech leading-relaxed text-fg-secondary">{content.demonstrates}</p>
          </div>

          <div class="flex flex-1 flex-col gap-5 border-t border-border-subtle pt-5">
            <div class="space-y-2">
              <h4 class="text-[11px] font-mono-tech text-fg-muted uppercase tracking-wider">
                {t('projects.problemLabel')}
              </h4>
              <p class="text-sm text-fg-secondary leading-relaxed text-pretty">
                {content.problem}
              </p>
            </div>
            <div class="space-y-2">
              <h4 class="text-[11px] font-mono-tech text-fg-muted uppercase tracking-wider">
                {t('projects.builtLabel')}
              </h4>
              <p class="text-sm text-fg-secondary leading-relaxed text-pretty">
                {content.built}
              </p>
            </div>

            <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-3 pt-2">
              {project.href && (
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-mono-tech tracking-wider uppercase text-fg-primary hover:text-fg-secondary underline underline-offset-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg-primary"
                >
                  <span>{t('projects.repoLink')}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {project.liveHref && (
                <a
                  href={project.liveHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-mono-tech tracking-wider uppercase text-fg-primary hover:text-fg-secondary underline underline-offset-4 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fg-primary"
                >
                  <span>{t('projects.liveLink')}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <footer class="mt-16 pt-6 border-t border-border-subtle text-xs font-mono-tech text-fg-secondary">
    <p>{t('projects.note')}</p>
  </footer>
</section>
