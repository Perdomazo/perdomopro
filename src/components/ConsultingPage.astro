          >
            <div class="min-w-0 space-y-1">
              <p class="text-[11px] font-mono-tech uppercase tracking-wider text-fg-muted">
                PerdomoPro
              </p>
              <p class="text-sm font-medium text-fg-primary group-hover:text-accent-primary transition-colors truncate">
                {copy.profileLinkLabel}
              </p>
            </div>
            <span class="text-fg-muted group-hover:text-accent-primary transition-transform duration-150 group-hover:translate-x-0.5 shrink-0" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Clean Automated Contact Form Box -->
      <div class="lg:col-span-7 border border-border-subtle bg-canvas-subtle/70 p-4 sm:p-8 shadow-xs" data-reveal-item>
        <form
          id="consulting-contact-form"
          class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4"
          data-form-error={copy.formError}
          data-form-loading={copy.loading}
          data-form-success={copy.formSuccess}
          data-form-failure={copy.formFailure}
          data-form-network-error={copy.formNetworkError}
          data-locale={locale}
        >
          <label class="sr-only" aria-hidden="true">
            {copy.trapLabel}
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>

          <label class="block text-xs text-fg-secondary">
            {copy.name}
            <span class="text-status-active" aria-hidden="true"> *</span>
            <input
              name="name"
              autocomplete="name"
              required
              class="mt-1.5 block w-full border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
            />
          </label>

          <label class="block text-xs text-fg-secondary">
            {copy.business}
            <input
              name="business"
              autocomplete="organization"
              class="mt-1.5 block w-full border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
            />
          </label>

          <label class="block text-xs text-fg-secondary">
            {copy.email}
            <span class="text-status-active" aria-hidden="true"> *</span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              required
              class="mt-1.5 block w-full border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
            />
          </label>

          <label class="block text-xs text-fg-secondary">
            {copy.phone}
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              class="mt-1.5 block w-full border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
            />
          </label>

          <label class="sm:col-span-2 block text-xs text-fg-secondary">
            {copy.problem}
            <span class="text-status-active" aria-hidden="true"> *</span>
            <textarea
              name="problem"
              required
              rows="3"
              class="mt-1.5 block w-full resize-y border border-border-subtle bg-canvas px-3 py-2.5 text-base sm:text-sm text-fg-primary outline-none transition-colors focus:border-accent-primary focus:ring-1 focus:ring-accent-primary"
            ></textarea>
          </label>

          <fieldset class="sm:col-span-2">
            <legend class="text-xs text-fg-secondary">{copy.method}</legend>
            <div class="mt-2.5 flex flex-wrap gap-x-6 gap-y-2.5 text-sm text-fg-primary">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="radio" name="preferred" value={copy.emailMethod} checked class="accent-accent-primary" />
                <span>{copy.emailMethod}</span>
              </label>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="radio" name="preferred" value={copy.phoneMethod} class="accent-accent-primary" />
                <span>{copy.phoneMethod}</span>
              </label>
            </div>
          </fieldset>

          <div class="sm:col-span-2 pt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <button
              type="submit"
              class="inline-flex w-full sm:w-auto justify-center items-center gap-2.5 bg-accent-primary px-5 py-3.5 sm:py-3 text-xs font-sans font-medium uppercase tracking-wider text-white shadow-xs transition-all hover:bg-accent-interactive hover:shadow-md disabled:cursor-wait disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary"
            >
              <span data-submit-label>{copy.submit}</span>
              <span aria-hidden="true">↗</span>
            </button>
            <p class="text-xs font-mono-tech text-fg-muted text-center sm:text-left">{copy.privacy}</p>
          </div>

          <p
            id="consulting-form-status"
            class="sm:col-span-2 min-h-5 text-xs text-fg-secondary"
            role="status"
            aria-live="polite"
          ></p>
        </form>
      </div>
    </div>
  </section>
</div>

<script>
  function setupConsultingForm() {
    const form = document.querySelector<HTMLFormElement>('#consulting-contact-form');
    const status = document.querySelector<HTMLElement>('#consulting-form-status');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    if (!form || !status || !submitBtn || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const values = new FormData(form);
      const name = String(values.get('name') ?? '').trim();
      const email = String(values.get('email') ?? '').trim();
      const problem = String(values.get('problem') ?? '').trim();
      const business = String(values.get('business') ?? '').trim();
      const phone = String(values.get('phone') ?? '').trim();
      const preferred = String(values.get('preferred') ?? (form.dataset.locale === 'en' ? 'Email' : 'Correo'));
      const description = String(values.get('problem') ?? '').trim();

      if (!name || !email || !problem) {
        status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
        status.textContent = form.dataset.formError ?? 'Faltan campos obligatorios.';
        return;
      }

      const submitLabel = submitBtn.querySelector<HTMLElement>('[data-submit-label]');
      const originalBtnText = submitLabel?.textContent ?? '';
      submitBtn.setAttribute('aria-busy', 'true');
      if (submitLabel) submitLabel.textContent = form.dataset.formLoading ?? 'Enviando…';
      submitBtn.disabled = true;
      status.textContent = '';
      status.className = 'sm:col-span-2 min-h-5 text-xs text-fg-secondary';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            nombre: name,
            correo: email,
            negocio: business,
            telefono: phone,
            preferencia: preferred,
            descripcion: description,
            servicio: 'Consultoría',
            sitioWeb: String(values.get('website') ?? ''),
            idioma: form.dataset.locale ?? 'es-MX',
          }),
        });

        await response.json().catch(() => null);
        if (response.ok) {
          form.reset();
          status.className = 'sm:col-span-2 min-h-5 text-xs text-emerald-700 font-medium';
          status.textContent = form.dataset.formSuccess ?? 'Mensaje enviado correctamente.';
        } else {
          status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
          status.textContent = form.dataset.formFailure ?? 'No se pudo enviar el mensaje. Inténtalo de nuevo.';
        }
      } catch {
        status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
        status.textContent = form.dataset.formNetworkError ?? 'Error de conexión. Inténtalo de nuevo o escribe directamente.';
      } finally {
        submitBtn.removeAttribute('aria-busy');
        if (submitLabel) submitLabel.textContent = originalBtnText;
        submitBtn.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', setupConsultingForm);
  setupConsultingForm();
</script>
