      specRoleLabel: 'Consultant',
      specRoleValue: 'Adrián Perdomo · Direct attention',
      specFocusLabel: 'Built for',
      specFocusValue: 'Distributors, service firms & SMBs',
      specStepLabel: 'First step',
      specStepValue: 'Written diagnosis & fixed quote',

      solutionsIndex: '02 / SOLUTIONS',
