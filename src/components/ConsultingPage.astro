      trapLabel: 'Leave this field empty',
      formSuccess: 'Message sent. I will get back to you shortly.',
      formFailure: 'Could not send your message right now. Please try again or email me directly.',
      formNetworkError: 'Connection error while sending. Please try again or email me directly.',
      formError: 'Please add your name, a valid email, and a short note on what you want to improve.',
