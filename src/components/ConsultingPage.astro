---
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/config';
import ParticlesBackground from './ParticlesBackground.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const en = locale === 'en';
const mail = siteConfig.links.email;
const homeHref = en ? '/en/' : '/';

export interface SolutionCard {
  num: string;
  category: string;
  title: string;
  pain: string;
  summary: string;
  bullets: string[];
  outcomePill: string;
}

export interface ProcessStep {
  step: string;
  timeline: string;
  title: string;
  desc: string;
  deliverable: string;
}

export interface ContractingTier {
  tierNumber: string;
  badge: string;
  name: string;
  subtitle: string;
  desc: string;
  inclusions: string[];
  idealFor: string;
}

export interface SovereigntyBlock {
  badge: string;
  title: string;
  desc: string;
  points: string[];
}

const copy = en
  ? {
      heroEyebrow: '01 / SMB CONSULTING · SOFTWARE, AUTOMATION & CLOUD',
      heroTitlePrefix: 'I turn everyday business processes into ',
      heroTitleHighlight: 'digital solutions.',
      heroIntro:
        'I help business owners and operations teams replace paper slips, duplicate manual entry, and scattered chat follow-ups with fast, practical tools built around how they actually work.',
