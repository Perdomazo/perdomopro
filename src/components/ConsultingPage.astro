      idealFor: 'PyMEs que necesitan claridad estratégica antes de decidir si comprar o programar software a medida.',
    },
    {
      tierNumber: '03',
      badge: 'CONTINUIDAD TÉCNICA',
      name: 'Acompañamiento continuo mensual',
      subtitle: 'Retainer de ingeniería y soporte',
      desc: 'Disponibilidad técnica periódica para mantenimiento de infraestructura, mejoras continuas y soporte prioritario sin la carga de una nómina fija.',
      inclusions: [
        'Bolsa mensual de horas acordada con atención prioritaria',
        'Mantenimiento preventivo y actualización de servicios',
        'Evolución de nuevas funciones según prioridades del mes',
        'Monitoreo de disponibilidad y estabilidad cloud',
      ],
      idealFor: 'Operaciones con sistemas en producción que necesitan un aliado tecnológico de confianza continuo.',
    },
  ],
  cloudSovereignty: {
    badge: 'TRANSPARENCIA & SOBERANÍA CLOUD',
    title: 'Tu negocio es dueño de sus cuentas y de su infraestructura',
    desc: 'Los servicios de nube (Azure, AWS, Vercel, dominios y bases de datos) se configuran directamente a nombre de tu empresa, con facturación directa del proveedor. Sin márgenes de reventa ocultos sobre hosting ni licencias cautivas: tú conservas el control total y la propiedad de tu código y datos.',
    points: [
      'Facturación directa a costo de proveedor',
      'Código fuente y repositorio 100% de tu propiedad',
      'Sin dependencias técnicas ni contratos cautivos',
    ],
  },
  supportNote: 'No hay precios fijos en esta página: el presupuesto exacto se define según el alcance, complejidad e integraciones necesarias tras la primera conversación.',
  faqLabel: 'PREGUNTAS FRECUENTES',
  faqTitle: 'Algunos detalles útiles antes de conversar.',
  faq: [
    ['¿Trabajas con negocios de cualquier tamaño?', 'El enfoque son pequeñas y medianas empresas que necesitan resolver un proceso concreto o desarrollar una solución digital. La compatibilidad depende del alcance y del tiempo disponible.'],
    ['¿Necesito saber qué tecnología quiero?', 'No. Es más útil explicar el proceso actual, quién participa y qué resulta difícil. Las decisiones tecnológicas vienen después de entender eso.'],
    ['¿Puedes dar soporte después de entregar?', 'Podemos incluir soporte y cambios posteriores en la propuesta. El alcance, expectativas de respuesta y costo se acuerdan por separado.'],
    ['¿Cómo estimas un proyecto?', 'Primero conversamos sobre el proceso y el resultado esperado. Después presento un alcance propuesto, entregables, supuestos y estimación para revisar.'],
    ['¿Los proyectos de esta página son trabajos para clientes?', 'No. Son proyectos personales y trabajo en mi propio sitio. Dan contexto sobre cómo construyo, no presentan resultados de clientes.'],
  ],
  contactLabel: 'HABLEMOS DE TU OPERACIÓN',
  contactTitle: '¿Qué te gustaría hacer más sencillo?',
  contactBody: 'Cuéntame un poco sobre el proceso o problema. Revisaré tu mensaje y te responderé por el medio que prefieras.',
  name: 'Tu nombre', business: 'Negocio (opcional)', email: 'Correo electrónico', phone: 'Teléfono (opcional)',
  problem: '¿Qué proceso o problema te gustaría mejorar?',
  method: '¿Cómo prefieres que te contacte?', emailMethod: 'Correo', phoneMethod: 'Teléfono',
  submit: 'Enviar mensaje', loading: 'Enviando…', direct: 'O escríbeme directamente a',
  privacy: 'Usaré tus datos para responder esta consulta.',
  trapLabel: 'Deja este campo vacío',
  formSuccess: 'Tu mensaje se envió correctamente. Te responderé pronto.',
  formFailure: 'No pude enviar tu mensaje. Inténtalo de nuevo o escríbeme directamente.',
  formNetworkError: 'Un error de conexión impidió enviar el mensaje. Inténtalo de nuevo o escríbeme directamente.',
  footerNote: 'Tecnología práctica, construida alrededor de necesidades reales.',
  formError: 'Agrega tu nombre, un correo válido y una breve descripción del problema.',
};

const projectIds = ['perdomopro', 'score-record'];
const examples = projectIds.map((id) => projectsData.find((project) => project.id === id)!).filter(Boolean);
const projectVisuals = {
  perdomopro: {
    src: '/images/projects/perdomopro-home.jpg',
    alt: en ? 'Screenshot of the PerdomoPro personal website' : 'Captura del sitio personal PerdomoPro',
  },
  'score-record': {
    overview: '/images/projects/scorerecord-overview.jpg',
    overviewAlt: en ? 'ScoreRecord project overview screen' : 'Pantalla de presentación del proyecto ScoreRecord',
    dashboard: '/images/projects/scorerecord-dashboard.jpg',
    dashboardAlt: en ? 'ScoreRecord football forecast dashboard' : 'Panel de pronósticos deportivos de ScoreRecord',
  },
} as const;
---

<div class="consulting-page" data-consulting-page>
  <section id="inicio-consultoria" class="relative isolate max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-12 sm:pt-16 pb-20 sm:pb-28" data-scroll-module>
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="relative z-10 border-y border-border-subtle bg-white/65 py-4 flex flex-wrap justify-between gap-3 text-[10px] sm:text-xs font-mono-tech tracking-[0.12em] text-fg-muted backdrop-blur-[2px]">
      <span>{copy.eyebrow}</span><span>{copy.heroMeta}</span>
    </div>
    <div class="relative z-10 grid lg:grid-cols-12 gap-12 lg:gap-8 pt-16 sm:pt-24 lg:pt-32 items-end">
      <div class="lg:col-span-8" data-reveal-item>
        <p class="mb-7 text-xs sm:text-sm font-mono-tech uppercase tracking-[0.13em] text-fg-secondary"><span class="mr-3 text-status-active" aria-hidden="true">■</span>{en ? 'SOFTWARE / AUTOMATION / CLOUD' : 'SOFTWARE / AUTOMATIZACIÓN / CLOUD'}</p>
        <h1 class="max-w-5xl font-sans text-4xl sm:text-6xl lg:text-7xl xl:text-[5.6rem] leading-[0.98] tracking-[-0.055em] text-fg-primary">{copy.heroTitle}</h1>
      </div>
      <div class="lg:col-span-4 lg:pb-2" data-reveal-item>
        <p class="text-lg sm:text-xl leading-relaxed text-fg-secondary">{copy.heroIntro}</p>
        <div class="mt-8 flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3">
          <a href="#contacto" class="group inline-flex justify-center items-center gap-3 bg-accent-primary px-5 py-3.5 text-sm text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-interactive hover:shadow-md active:translate-y-0 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary">{copy.start}<span class="transition-transform group-hover:translate-x-1" aria-hidden="true">↗</span></a>
          <a href="#soluciones" class="group inline-flex justify-center items-center gap-3 border border-border-subtle px-5 py-3.5 text-sm text-fg-primary transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-primary hover:bg-accent-subtle active:translate-y-0 active:scale-[0.98]">{copy.explore}<span class="transition-transform group-hover:translate-y-0.5" aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
    <div class="relative z-10 mt-20 sm:mt-28 border border-border-subtle bg-white/75 p-6 sm:p-10 shadow-sm backdrop-blur-[2px]" data-reveal-item>
      <p class="mb-7 text-[10px] font-mono-tech tracking-[0.14em] text-fg-muted">{copy.cue}</p>
      <div class="grid sm:grid-cols-3 gap-3 sm:gap-0 items-stretch">
        {copy.flow.map((step, index) => <div class="flex items-center gap-3 sm:px-5 first:pl-0 last:pr-0" data-flow-step>
          <span class="text-xs font-mono-tech text-fg-muted">0{index + 1}</span><span class="text-sm sm:text-base text-fg-primary">{step}</span>
          {index < copy.flow.length - 1 && <span class="hidden sm:block ml-auto text-fg-muted" aria-hidden="true">→</span>}
        </div>)}
      </div>
    </div>
  </section>

  <!-- 01 // PROBLEMAS Y FRICCIONES -->
  <section id="problemas" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24" data-scroll-module>
    <header class="border border-border-subtle bg-canvas-subtle shadow-sm px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-xs font-mono-tech tracking-wider text-fg-secondary">
      <span>01 // {en ? 'PROBLEMS & FRICTIONS' : 'PROBLEMAS Y FRICCIONES'}</span>
      <span>{copy.sectionLabel}</span>
    </header>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 pt-12 sm:pt-16">
      <div class="lg:col-span-5" data-reveal-item>
        <h2 class="text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.problemsTitle}</h2>
        <p class="mt-6 max-w-xl leading-relaxed text-fg-secondary">{copy.problemsLead}</p>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-4">
        {copy.problems.map((problem, i) => (
          <article class="flex flex-col justify-between border border-border-subtle bg-canvas-subtle p-5 sm:p-6 shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:border-amber-700/30 hover:shadow-md" data-reveal-item>
            <div>
              <div class="flex items-center justify-between gap-3">
                <p class="text-[10px] font-mono-tech tracking-widest text-fg-muted">0{i + 1} / {en ? 'FRICTION' : 'FRICCIÓN'}</p>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 border border-amber-500/25 bg-amber-500/10 text-amber-900 font-mono-tech text-[10px] tracking-wider uppercase font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-600" aria-hidden="true"></span>
                  {problem.tag}
                </span>
              </div>
              <h3 class="mt-4 text-lg font-semibold text-fg-primary">{problem.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{problem.desc}</p>
            </div>
            <div class="mt-5 pt-3.5 border-t border-border-subtle/80 flex items-start gap-2 text-xs font-mono-tech text-fg-secondary">
              <span class="text-amber-700 font-bold shrink-0 mt-0.5" aria-hidden="true">↳</span>
              <span><strong class="text-amber-900 font-semibold">{en ? 'Bottleneck:' : 'Cuello de botella:'}</strong> {problem.bottleneck}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 // SOLUCIONES DE ALTO VALOR -->
  <section id="soluciones" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24" data-scroll-module>
    <header class="border border-border-subtle bg-canvas-subtle shadow-sm px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-xs font-mono-tech tracking-wider text-fg-secondary">
      <span>02 // {en ? 'SOLUTIONS' : 'SOLUCIONES'}</span>
      <span>{copy.solutionsLabel}</span>
    </header>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 pt-12 sm:pt-16">
      <div class="lg:col-span-5" data-reveal-item>
        <h2 class="text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.solutionsTitle}</h2>
        <p class="mt-6 max-w-xl leading-relaxed text-fg-secondary">{copy.solutionsLead}</p>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-4">
        {copy.solutions.map((solution, i) => (
          <article class:list={[
            "group relative flex flex-col justify-between overflow-hidden border border-border-subtle bg-canvas p-6 sm:p-7 shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-primary/40 hover:shadow-lg focus-within:ring-2 focus-within:ring-accent-primary",
            solution.isFeatured ? "sm:col-span-2 ring-1 ring-accent-primary/15" : "sm:col-span-1"
          ]} data-reveal-item>
            <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-accent-primary via-accent-interactive to-transparent" aria-hidden="true"></div>

            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <span class="font-mono-tech text-xs font-semibold text-accent-primary">0{i + 1}</span>
                  <span class="h-3 w-px bg-border-subtle" aria-hidden="true"></span>
                  <span class="text-[10px] font-mono-tech uppercase tracking-wider text-fg-muted">{solution.focus}</span>
                </div>
                {solution.isFeatured && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-accent-subtle text-accent-primary border border-accent-primary/20 text-[10px] font-mono-tech tracking-wider uppercase font-semibold">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent-primary" aria-hidden="true"></span>
                    {en ? 'CORE PLATFORM' : 'SISTEMA CENTRAL'}
                  </span>
                )}
              </div>

              <h3 class:list={[
                "font-semibold text-fg-primary",
                solution.isFeatured ? "mt-4 text-xl sm:text-2xl" : "mt-4 text-lg"
              ]}>{solution.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{solution.desc}</p>

              <div class="mt-5 pt-4 border-t border-border-subtle">
                <p class="text-[10px] font-mono-tech uppercase tracking-wider text-fg-muted font-semibold">{en ? 'KEY DELIVERABLES' : 'ENTREGABLES CLAVE'}</p>
                <ul class:list={[
                  "mt-2.5 space-y-2 text-xs text-fg-secondary list-none p-0 m-0",
                  solution.isFeatured ? "grid sm:grid-cols-2 gap-x-4 gap-y-2 space-y-0" : ""
                ]}>
                  {solution.deliverables.map((item) => (
                    <li class="flex items-start gap-2">
                      <svg class="w-3.5 h-3.5 text-status-active shrink-0 mt-0.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-5 pt-3.5 border-t border-border-subtle/80 text-xs font-mono-tech text-fg-muted">
              <span class="text-accent-primary font-semibold">{en ? 'Best for:' : 'Ideal para:'}</span> {solution.useCase}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 // PROCESO: Stepper Secuencial Conectado -->
  <section id="proceso" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-16 sm:pt-24 pb-8 sm:pb-12" data-scroll-module>
    <header class="border border-border-subtle bg-canvas-subtle shadow-sm px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-xs font-mono-tech tracking-wider text-fg-secondary">
      <span>03 // {en ? 'PROCESS' : 'PROCESO'}</span>
      <span>{copy.processLabel}</span>
    </header>

    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 pt-10 sm:pt-14 items-end" data-reveal-item>
      <div class="lg:col-span-6">
        <h2 class="text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.processTitle}</h2>
      </div>
      <div class="lg:col-span-6">
        <p class="max-w-xl leading-relaxed text-fg-secondary">{copy.processLead}</p>
      </div>
    </div>

    <!-- Stepper Pipeline Track Container -->
    <div class="relative mt-12 sm:mt-16 pt-2">
      <!-- Desktop Continuous Progress Rail (>= 768px md:) -->
      <div class="hidden md:block absolute top-[28px] left-[16.66%] right-[16.66%] h-[2px] bg-border-muted z-0 pointer-events-none" aria-hidden="true">
        <div class="h-full w-full bg-gradient-to-r from-accent-primary via-accent-interactive to-accent-primary/60"></div>
      </div>

      <!-- Stepper List with 3 Phases -->
      <ol class="relative z-10 grid md:grid-cols-3 gap-6 sm:gap-8 list-none m-0 p-0">
        {copy.process.map((phase, i) => (
          <li class="group relative flex flex-col justify-between border border-border-subtle bg-canvas p-6 sm:p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-primary/40 hover:shadow-md" data-reveal-item>
            <!-- Top Header: Milestone Circle Node & Timeline Badge -->
            <div>
              <div class="flex items-center justify-between gap-3 mb-5">
                <!-- Circular Milestone Node 01-03 -->
                <div class="relative z-10 w-11 h-11 rounded-full border-2 border-accent-primary bg-canvas text-accent-primary flex items-center justify-center font-mono-tech text-sm font-bold shadow-xs group-hover:bg-accent-primary group-hover:text-white transition-colors duration-200">
                  {phase.step}
                </div>

                <!-- Phase Tag / Timeline -->
                <span class="inline-flex items-center px-2.5 py-1 rounded-xs border border-border-subtle bg-canvas-subtle font-mono-tech text-[10px] text-fg-muted uppercase tracking-wider">
                  {phase.timeline}
                </span>
              </div>

              <!-- Phase Title -->
              <h3 class="text-lg font-medium text-fg-primary tracking-tight">{phase.title}</h3>

              <!-- Phase Narrative Description -->
              <p class="mt-3 text-sm leading-relaxed text-fg-secondary">{phase.desc}</p>
            </div>

            <!-- Bottom Deliverable Card Footnote -->
            <div class="mt-6 pt-4 border-t border-border-subtle/80 bg-canvas-subtle/60 -mx-6 -mb-6 sm:-mx-7 sm:-mb-7 p-4 sm:p-5 rounded-b-xs">
              <div class="flex items-center gap-1.5 text-[10px] font-mono-tech uppercase tracking-wider text-accent-primary font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-status-active" aria-hidden="true"></span>
                <span>{en ? 'KEY DELIVERABLE' : 'ENTREGABLE CLAVE'}</span>
              </div>
              <p class="mt-1.5 text-xs text-fg-primary leading-relaxed font-medium">
                {phase.deliverable}
              </p>
              <div class="mt-2 text-[10px] font-mono-tech text-fg-muted">
                <span>↳ {phase.checkpoint}</span>
              </div>
            </div>

            <!-- Inter-card Directional Connectors -->
            <!-- Desktop horizontal connector arrow across gap -->
            {i < 2 && (
              <div class="hidden md:flex absolute -right-3.5 lg:-right-4.5 top-[28px] -translate-y-1/2 z-20 items-center justify-center w-6 h-6 rounded-full bg-canvas border border-border-muted text-accent-primary text-xs font-bold shadow-xs" aria-hidden="true">
                →
              </div>
            )}

            <!-- Mobile vertical connector arrow across gap -->
            {i < 2 && (
              <div class="md:hidden flex items-center justify-center -my-3 z-10" aria-hidden="true">
                <div class="w-6 h-6 rounded-full bg-canvas border border-border-muted text-accent-primary text-xs font-bold flex items-center justify-center shadow-xs">
                  ↓
                </div>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 // PROYECTOS -->
  <section id="proyectos" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-2 sm:pt-3 pb-8 sm:pb-10" data-scroll-module>
    <header class="border border-border-subtle bg-canvas-subtle shadow-sm px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-xs font-mono-tech tracking-wider text-fg-secondary"><span>04 // {en ? 'PROJECTS' : 'PROYECTOS'}</span><span>{copy.examplesLabel}</span></header>
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 pt-10 sm:pt-14 items-end" data-reveal-item>
      <h2 class="lg:col-span-6 text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.examplesTitle}</h2>
      <p class="lg:col-span-5 lg:col-start-8 max-w-2xl leading-relaxed text-fg-secondary">{copy.examplesLead}</p>
    </div>
    <div class="mt-8 sm:mt-10 grid md:grid-cols-2 gap-5 sm:gap-6">
      {examples.map((project, i) => {
        const content = project.content[locale];
        const visual = projectVisuals[project.id as keyof typeof projectVisuals];
        return <article class="group relative flex h-full flex-col overflow-hidden border border-border-subtle bg-canvas shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-primary/30 hover:shadow-xl hover:shadow-accent-primary/5 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-accent-primary" data-reveal-item>
          <div class="absolute inset-x-0 top-0 z-10 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-accent-primary via-accent-interactive to-transparent transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></div>
          <div class="relative overflow-hidden border-b border-border-subtle bg-canvas-subtle">
            {project.id === 'score-record' && 'overview' in visual ? (
              <div class="relative aspect-[16/9]">
                <img src={visual.overview} alt={visual.overviewAlt} loading="lazy" decoding="async" class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]" />
                <figure class="absolute bottom-3 right-3 w-[42%] overflow-hidden border-2 border-canvas bg-canvas shadow-lg sm:bottom-5 sm:right-5">
                  <img src={visual.dashboard} alt={visual.dashboardAlt} loading="lazy" decoding="async" class="aspect-[2/1] h-full w-full object-cover object-top" />
                </figure>
              </div>
            ) : 'src' in visual ? (
              <img src={visual.src} alt={visual.alt} loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]" />
            ) : null}
          </div>
          <div class="flex flex-1 flex-col p-5 sm:p-7">
            <div class="flex flex-wrap justify-between gap-3 text-[10px] font-mono-tech tracking-widest text-fg-muted"><span>0{i + 1} // {content.title}</span><span>{project.liveHref ? (en ? 'OWN SITE · AZURE' : 'SITIO PROPIO · AZURE') : copy.exampleType}</span></div>
            <h3 class="mt-5 text-2xl text-fg-primary">{content.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-fg-secondary">{content.problem}</p>
            <div class="mt-5 border-l-2 border-border-subtle pl-4"><p class="text-xs font-mono-tech text-fg-muted">{en ? 'WHAT I BUILT' : 'QUÉ CONSTRUÍ'}</p><p class="mt-2 text-sm leading-relaxed text-fg-secondary">{content.built}</p></div>
            <div class="mt-5 flex flex-wrap gap-2">{project.technologies.slice(0, 5).map((tech) => <span class="border border-border-subtle px-2 py-1 text-[10px] font-mono-tech text-fg-muted">{tech}</span>)}</div>
            {(project.href || project.liveHref) && <div class="mt-auto pt-6 flex flex-wrap gap-5">{project.href && <a href={project.href} target="_blank" rel="noopener noreferrer" class="text-xs text-fg-primary underline underline-offset-4 decoration-border-muted hover:decoration-fg-primary"><span>GitHub</span><span class="sr-only">{en ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span><span aria-hidden="true"> ↗</span></a>}{project.liveHref && <a href={project.liveHref} target="_blank" rel="noopener noreferrer" class="text-xs text-fg-primary underline underline-offset-4 decoration-border-muted hover:decoration-fg-primary"><span>{copy.exampleLink}</span><span class="sr-only">{en ? ' (opens in a new tab)' : ' (se abre en una pestaña nueva)'}</span><span aria-hidden="true"> ↗</span></a>}</div>}
          </div>
        </article>;
      })}
    </div>
  </section>

  <!-- 05 // CLOUD -->
  <section class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-8 sm:pt-10 pb-16 sm:pb-24" data-scroll-module>
    <div class="border border-border-subtle bg-canvas-subtle p-6 sm:p-10 lg:p-14 shadow-sm" data-reveal-item>
      <div class="grid lg:grid-cols-12 gap-10 items-start"><div class="lg:col-span-5"><p class="text-xs font-mono-tech tracking-widest text-fg-muted">05 // {copy.cloudLabel}</p><h2 class="mt-6 text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.cloudTitle}</h2></div><div class="lg:col-span-7"><p class="text-base sm:text-lg leading-relaxed text-fg-secondary">{copy.cloudBody}</p><ul class="mt-8 list-none p-0 m-0 divide-y divide-border-subtle border-y border-border-subtle">{copy.cloudPoints.map((point, i) => <li class="flex gap-4 py-4 text-sm text-fg-primary"><span class="font-mono-tech text-xs text-fg-muted">0{i + 1}</span>{point}</li>)}</ul></div></div>
    </div>
  </section>

  <!-- 06 // COMPATIBILIDAD -->
  <section class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24" data-scroll-module>
    <header class="border border-border-subtle bg-canvas-subtle shadow-sm px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-xs font-mono-tech tracking-wider text-fg-secondary"><span>06 // {en ? 'FIT' : 'COMPATIBILIDAD'}</span><span>{copy.fitLabel}</span></header>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 pt-12 sm:pt-16"><div class="lg:col-span-5" data-reveal-item><h2 class="text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.fitTitle}</h2><p class="mt-6 leading-relaxed text-fg-secondary">{copy.fitLead}</p></div><ul class="lg:col-span-7 list-none m-0 p-0 border-t border-border-subtle">{copy.fitPoints.map((point, i) => <li class="flex gap-4 py-5 border-b border-border-subtle text-sm sm:text-base leading-relaxed text-fg-secondary" data-reveal-item><span class="font-mono-tech text-xs text-fg-muted">0{i + 1}</span>{point}</li>)}</ul></div>
  </section>

  <!-- 07 // INVERSIÓN Y ALCANCE -->
  <section id="inversion" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24" data-scroll-module>
    <header class="border border-border-subtle bg-canvas-subtle shadow-sm px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-xs font-mono-tech tracking-wider text-fg-secondary">
      <span>07 // {en ? 'INVESTMENT' : 'INVERSIÓN'}</span>
      <span>{copy.investmentLabel}</span>
    </header>

    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 pt-10 sm:pt-14 items-end" data-reveal-item>
      <div class="lg:col-span-6">
        <h2 class="text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.investmentTitle}</h2>
      </div>
      <div class="lg:col-span-6">
        <p class="max-w-xl leading-relaxed text-fg-secondary">{copy.investmentLead}</p>
      </div>
    </div>

    <!-- 3 Contracting Tier Cards Grid -->
    <div class="mt-12 sm:mt-16 grid md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      {copy.investmentTiers.map((tier, i) => (
        <article class="group relative flex flex-col justify-between border border-border-subtle bg-canvas p-6 sm:p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-primary/40 hover:shadow-md" data-reveal-item>
          <!-- Top Accent Border on Hover -->
          <div class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-accent-primary via-accent-interactive to-transparent transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></div>

          <div>
            <!-- Tier Header Strip -->
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class="font-mono-tech text-xs font-semibold text-accent-primary">
                0{i + 1} // {tier.badge}
              </span>
              <span class="w-2 h-2 rounded-full bg-accent-primary/20 group-hover:bg-accent-primary transition-colors" aria-hidden="true"></span>
            </div>

            <!-- Tier Title & Subtitle -->
            <h3 class="text-xl font-medium text-fg-primary tracking-tight">{tier.name}</h3>
            <p class="mt-1 text-xs font-mono-tech text-fg-muted uppercase tracking-wider">{tier.subtitle}</p>

            <!-- Narrative Description -->
            <p class="mt-4 text-sm leading-relaxed text-fg-secondary">{tier.desc}</p>

            <!-- Checklist of Inclusions -->
            <div class="mt-6 pt-5 border-t border-border-subtle">
              <p class="text-[10px] font-mono-tech uppercase tracking-wider text-fg-muted font-semibold">
                {en ? 'WHAT IS INCLUDED' : 'QUÉ INCLUYE ESTA MODALIDAD'}
              </p>
              <ul class="mt-3 space-y-2 text-xs text-fg-secondary list-none p-0 m-0">
                {tier.inclusions.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-status-active font-bold mt-0.5" aria-hidden="true">✓</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Ideal For Footnote -->
          <div class="mt-6 pt-4 border-t border-border-subtle/80 bg-canvas-subtle/60 -mx-6 -mb-6 sm:-mx-7 sm:-mb-7 p-4 rounded-b-xs">
            <p class="text-[10px] font-mono-tech uppercase tracking-wider text-fg-muted">
              {en ? 'IDEAL FIT:' : 'IDEAL PARA:'}
            </p>
            <p class="mt-1 text-xs text-fg-secondary leading-relaxed font-normal">
              {tier.idealFor}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Cloud Sovereignty & Infrastructure Transparency Banner -->
    <div class="mt-8 sm:mt-10 border border-border-subtle bg-canvas-subtle p-6 sm:p-8 lg:p-10 shadow-xs" data-reveal-item>
      <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-start">
        <div class="lg:col-span-4">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xs border border-accent-primary/25 bg-accent-subtle text-accent-primary font-mono-tech text-[10px] tracking-widest uppercase font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-primary" aria-hidden="true"></span>
            {copy.cloudSovereignty.badge}
          </span>
          <h4 class="mt-3 text-lg sm:text-xl font-medium text-fg-primary tracking-tight leading-snug">
            {copy.cloudSovereignty.title}
          </h4>
        </div>
        <div class="lg:col-span-8 space-y-4">
          <p class="text-sm leading-relaxed text-fg-secondary">
            {copy.cloudSovereignty.desc}
          </p>
          <div class="grid sm:grid-cols-3 gap-3 pt-2">
            {copy.cloudSovereignty.points.map((point) => (
              <div class="flex items-center gap-2 p-2.5 bg-canvas border border-border-subtle rounded-xs text-xs font-mono-tech text-fg-primary">
                <span class="text-status-active font-bold" aria-hidden="true">✓</span>
                <span class="leading-snug">{point}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- General Support & Scope Footnote -->
    <p class="mt-6 text-xs leading-relaxed text-fg-muted text-center" data-reveal-item>
      {copy.supportNote}
    </p>
  </section>

  <!-- 08 // FAQ -->
  <section id="faq" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24" data-scroll-module>
    <header class="border border-border-subtle bg-canvas-subtle shadow-sm px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-xs font-mono-tech tracking-wider text-fg-secondary"><span>08 // FAQ</span><span>{copy.faqLabel}</span></header>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 pt-12 sm:pt-16"><div class="lg:col-span-5" data-reveal-item><h2 class="text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.faqTitle}</h2></div><div class="lg:col-span-7 divide-y divide-border-subtle border-y border-border-subtle">{copy.faq.map(([question, answer]) => <details class="group py-5" data-reveal-item><summary class="cursor-pointer list-none flex justify-between gap-5 text-base text-fg-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fg-primary"><span>{question}</span><span class="font-mono-tech text-fg-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="max-w-2xl pt-4 pr-8 text-sm leading-relaxed text-fg-secondary">{answer}</p></details>)}</div></div>
  </section>

  <!-- 09 // CONTACTO -->
  <section id="contacto" class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-24" data-scroll-module>
    <div class="border border-border-subtle bg-canvas-subtle p-6 sm:p-10 lg:p-14 shadow-sm"><div class="grid lg:grid-cols-12 gap-10 lg:gap-16"><div class="lg:col-span-5" data-reveal-item><p class="text-xs font-mono-tech tracking-widest text-fg-muted">09 // {copy.contactLabel}</p><h2 class="mt-6 text-3xl sm:text-5xl leading-tight tracking-[-0.04em] text-fg-primary">{copy.contactTitle}</h2><p class="mt-6 leading-relaxed text-fg-secondary">{copy.contactBody}</p><p class="mt-8 text-xs font-mono-tech text-fg-muted">{copy.direct}</p><a class="mt-2 inline-block text-base text-fg-primary underline underline-offset-4" href={`mailto:${mail}`}>{mail}</a></div>
      <form id="consulting-contact-form" class="lg:col-span-7 grid sm:grid-cols-2 gap-x-5 gap-y-5" data-form-error={copy.formError} data-form-loading={copy.loading} data-form-success={copy.formSuccess} data-form-failure={copy.formFailure} data-form-network-error={copy.formNetworkError} data-locale={locale} data-reveal-item>
        <label class="sr-only" aria-hidden="true">{copy.trapLabel}<input name="website" tabindex="-1" autocomplete="off" /></label>
        <label class="block text-xs text-fg-secondary">{copy.name}<span class="text-status-active" aria-hidden="true"> *</span><input name="name" autocomplete="name" required class="mt-2 block w-full border border-border-subtle bg-canvas px-3 py-3 text-sm text-fg-primary outline-none focus:border-fg-primary focus:ring-1 focus:ring-fg-primary" /></label>
        <label class="block text-xs text-fg-secondary">{copy.business}<input name="business" autocomplete="organization" class="mt-2 block w-full border border-border-subtle bg-canvas px-3 py-3 text-sm text-fg-primary outline-none focus:border-fg-primary focus:ring-1 focus:ring-fg-primary" /></label>
        <label class="block text-xs text-fg-secondary">{copy.email}<span class="text-status-active" aria-hidden="true"> *</span><input type="email" name="email" autocomplete="email" required class="mt-2 block w-full border border-border-subtle bg-canvas px-3 py-3 text-sm text-fg-primary outline-none focus:border-fg-primary focus:ring-1 focus:ring-fg-primary" /></label>
        <label class="block text-xs text-fg-secondary">{copy.phone}<input type="tel" name="phone" autocomplete="tel" class="mt-2 block w-full border border-border-subtle bg-canvas px-3 py-3 text-sm text-fg-primary outline-none focus:border-fg-primary focus:ring-1 focus:ring-fg-primary" /></label>
        <label class="sm:col-span-2 block text-xs text-fg-secondary">{copy.problem}<span class="text-status-active" aria-hidden="true"> *</span><textarea name="problem" required rows="4" class="mt-2 block w-full resize-y border border-border-subtle bg-canvas px-3 py-3 text-sm text-fg-primary outline-none focus:border-fg-primary focus:ring-1 focus:ring-fg-primary"></textarea></label>
        <fieldset class="sm:col-span-2"><legend class="text-xs text-fg-secondary">{copy.method}</legend><div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm text-fg-primary"><label class="inline-flex items-center gap-2"><input type="radio" name="preferred" value={copy.emailMethod} checked class="accent-fg-primary" />{copy.emailMethod}</label><label class="inline-flex items-center gap-2"><input type="radio" name="preferred" value={copy.phoneMethod} class="accent-fg-primary" />{copy.phoneMethod}</label></div></fieldset>
        <div class="sm:col-span-2 flex flex-col sm:flex-row sm:items-center gap-4"><button type="submit" class="inline-flex justify-center items-center gap-3 bg-accent-primary px-5 py-3.5 text-sm text-white transition-all hover:bg-accent-interactive hover:shadow-md disabled:cursor-wait disabled:opacity-60"><span data-submit-label>{copy.submit}</span><span aria-hidden="true">↗</span></button><p class="text-xs text-fg-muted">{copy.privacy}</p></div>
        <p id="consulting-form-status" class="sm:col-span-2 min-h-5 text-xs text-fg-secondary" role="status" aria-live="polite"></p>
      </form>
    </div></div>
  </section>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pb-16 text-center"><p class="text-xs font-mono-tech tracking-wide text-fg-muted">{copy.footerNote}</p></div>
</div>

<script>
  function setupConsultingForm() {
    const form = document.querySelector<HTMLFormElement>('#consulting-contact-form');
    const status = document.querySelector<HTMLElement>('#consulting-form-status');
    const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    
    if (!form || !status || !submitBtn || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';
    
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      
      const values = new FormData(form);
      const name = String(values.get('name') ?? '').trim();
      const email = String(values.get('email') ?? '').trim();
      const problem = String(values.get('problem') ?? '').trim();
      const business = String(values.get('business') ?? '').trim();
      const phone = String(values.get('phone') ?? '').trim();
      const preferred = String(values.get('preferred') ?? (form.dataset.locale === 'en' ? 'Email' : 'Correo'));
      const description = String(values.get('problem') ?? '').trim();
      
      if (!name || !email || !problem) {
        status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
        status.textContent = form.dataset.formError ?? 'Faltan campos obligatorios.';
        return;
      }
      
      const submitLabel = submitBtn.querySelector<HTMLElement>('[data-submit-label]');
      const originalBtnText = submitLabel?.textContent ?? '';
      submitBtn.setAttribute('aria-busy', 'true');
      if (submitLabel) submitLabel.textContent = form.dataset.formLoading ?? 'Enviando…';
      submitBtn.disabled = true;
      status.textContent = '';
      status.className = 'sm:col-span-2 min-h-5 text-xs text-fg-secondary';
      
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            nombre: name,
            correo: email,
            negocio: business,
            telefono: phone,
            preferencia: preferred,
            descripcion: description,
            servicio: 'Consultoría',
            sitioWeb: String(values.get('website') ?? ''),
            idioma: form.dataset.locale ?? 'es-MX'
          })
        });
        
        await response.json().catch(() => null);
        if (response.ok) {
          form.reset();
          status.className = 'sm:col-span-2 min-h-5 text-xs text-emerald-700 font-medium';
          status.textContent = form.dataset.formSuccess ?? 'Mensaje enviado correctamente.';
        } else {
          status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
          status.textContent = form.dataset.formFailure ?? 'No se pudo enviar el mensaje. Inténtalo de nuevo.';
        }
      } catch {
        status.className = 'sm:col-span-2 min-h-5 text-xs text-amber-700 font-medium';
        status.textContent = form.dataset.formNetworkError ?? 'Error de conexión. Inténtalo de nuevo o escribe directamente.';
      } finally {
        submitBtn.removeAttribute('aria-busy');
        if (submitLabel) submitLabel.textContent = originalBtnText;
        submitBtn.disabled = false;
      }
    });
  }
  document.addEventListener('astro:page-load', setupConsultingForm);
  setupConsultingForm();
</script>
