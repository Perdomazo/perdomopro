<div class="consulting-page" data-consulting-page>
  <!-- 01 / CONSULTORÍA PYME (Centered Minimalist First-Fold on Mobile <640px, Original Full Editorial Hero on sm+) -->
  <section
    id="inicio-consultoria"
    data-scroll-module
    class="relative isolate w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-4 pb-16 sm:py-16 min-h-[calc(100svh-4rem)] sm:min-h-[calc(100svh-5rem)] flex flex-col justify-center"
    aria-labelledby="consulting-hero-heading"
  >
    <ParticlesBackground id="perdomopro-particles-consulting" />

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 items-center my-auto pointer-events-none">
      <!-- Primary Content Column -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col items-center text-center sm:block sm:text-left space-y-5 sm:space-y-7">
        <div
          class="inline-flex items-center justify-center sm:justify-start gap-2 text-[11px] sm:text-xs font-mono-tech tracking-[0.14em] sm:tracking-wider uppercase text-accent-primary sm:text-fg-primary font-medium"
          data-hero-meta="category"
        >
          <span class="inline-block w-2 h-2 rounded-full bg-status-active shrink-0" aria-hidden="true"></span>
          <span class="sm:hidden">{en ? 'TECHNOLOGY CONSULTING FOR SMBS' : 'CONSULTORÍA TECNOLÓGICA PYME'}</span>
          <span class="hidden sm:inline">{copy.heroEyebrow}</span>
        </div>

        <h1
          id="consulting-hero-heading"
          class="w-full text-[1.9rem] min-[390px]:text-[2.1rem] sm:text-5xl md:text-6xl lg:text-[3.55rem] xl:text-[3.9rem] font-normal tracking-[-0.035em] leading-[1.15] sm:leading-[1.1] text-fg-primary max-w-3xl"
          data-hero-headline
        >
          <span>{copy.heroTitlePrefix}</span>
          <span class="font-medium underline decoration-border-muted underline-offset-4 sm:underline-offset-8 decoration-1">{copy.heroTitleHighlight}</span>
        </h1>

        <!-- CTAs & Value Summary -->
        <div class="w-full pt-0.5 sm:pt-2 pointer-events-auto" data-hero-cta>
          <!-- MOBILE (<640px): Concise 2-line synthesis + 1 centered primary CTA + lightweight secondary link -->
          <div class="sm:hidden space-y-6">
