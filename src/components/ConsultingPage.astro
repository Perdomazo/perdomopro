      contactIndex: '05 / CONTACT',
      contactTitle: 'Let’s talk about your operation',
      contactBody:
        'Tell me briefly which process is slowing your team down today. I will reply within 24 business hours via your preferred channel.',
      directLabel: 'Direct email',
      profileLinkLabel: 'Review technical background & portfolio',
      name: 'Your name',
      business: 'Business name (optional)',
      email: 'Email address',
      phone: 'WhatsApp or phone (optional)',
      problem: 'Which process or bottleneck would you like to improve?',
      method: 'Preferred way to reach you',
      emailMethod: 'Email',
      phoneMethod: 'WhatsApp / Phone',
      submit: 'Send message',
      loading: 'Sending…',
